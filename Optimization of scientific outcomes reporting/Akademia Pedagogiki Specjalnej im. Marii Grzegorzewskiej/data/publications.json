m. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["5e709350878c28a0473a7101"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"},{"id":"5e70918b878c28a04737df12","uid":"bSF86rQ-ANh5a2UJEdITniQ","uuid":"1fe7062c-c4d6-471b-822c-3cafe0470f29","name":"Wydział Chemii","affiliatedPersonIDs":["5e7094c0878c28a0473c3146"],"parentId":"5e70918a878c28a04737de14","parentUuid":"511d4dfc-574e-4801-af14-e99dc24f8209","rootId":"5e70918a878c28a04737de14","rootUuid":"511d4dfc-574e-4801-af14-e99dc24f8209","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","bookEvaluation":{"scientificEdition":false,"translationToPolish":false,"translationFromPolish":false,"bookProjectNCN":false,"bookProjectFNP":false,"bookProjectNPHR":false,"bookProjectUE":false},"contributionOrder":{"EDITOR":["5e70942a878c28a0473b77df","5e70928b878c28a047397a5b"],"AUTHOR":["5e70942a878c28a0473b77df","5e70928b878c28a047397a5b","5e70922f878c28a047391540","5e7092cb878c28a04739cba6","5e709350878c28a0473a7101","6088cb3d9543c73526c48c47","5e709310878c28a0473a23dd","5e70928b878c28a047397994","634b0caf4097074b11e6163d","6035d0849543c7410626fb7b","617616a97523400564d33084","634b0caf4097074b11e6163e","5e70928c878c28a047397b9b","634b0caf4097074b11e6163f","5e7092b3878c28a04739aedd","5e70928c878c28a047397af6","5e7092f5878c28a04739ff35","5e7094c0878c28a0473c3146"]},"_version":4,"isbn":"978-83-961942-4-4","pages":293,"translation":false,"publicationPlace":"Warszawa","publisher":{"objectId":"5ec00d06ad49b31ccedea39d","name":"Instytut Ochrony Środowiska - Państwowy Instytut Badawczy w Warszawie","documentHash":"949ebbee-6e82-4054-bd79-b82b8545594d"},"editors":[{"objectId":"5e70942a878c28a0473b77df","name":"Marcin","lastName":"Chrzanowski","uuid":"336C27933099D43BFD63EAFD0971184F6445DB917BB17AF9A4EEAC6A2C84DA8D0C640BE3A3C156002412AE3E6CA7057A3274870CF0D466C67FFD68C863840A25","orcidId":"0000-0003-1109-4236","documentHash":"bf7c7624-9631-448f-b4d3-f1e2fbfc9fea"},{"objectId":"5e70928b878c28a047397a5b","name":"Ilona","lastName":"Żeber-Dzikowska","uuid":"64BDC8019894F78F164ED39EA5A040A88C21FA3B808D63B76DBE2CFFA9EFDD2F8132AAD87DAF30AB6AEE268E1B4140CDE524112A74443D97755B6B1E228118C6","orcidId":"0000-0002-2815-914X","documentHash":"97241b69-ace0-4540-b1f4-a1adfc1381ae"}],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[],"lastRefresh":"1761904281487"},{"authors":[{"objectId":"60c2fea39543c723365438ed","name":"Kamil","lastName":"Jaros","uuid":"AEDD96B3FFB6D5AF9881DF9C2727A67BB87542749C0C1554F54BDB9C481ECCFD8A50C49D2A36E68835ED8952579A7037912F6E625BEF2DD708CB4B6DD15C8A83","orcidId":"0000-0002-4056-4068","documentHash":"f8d52a78-4b58-48fa-9831-6c17b73d68c2"}],"objectId":"634c879440970729d9476661","publicUri":"https://www.researchgate.net/publication/361612004_Ryzyko_i_konsekwencje_zaburzen_glosu_wystepujacych_po_chorobie_COVID-19_oraz_ich_wplyw_na_prace_nauczyciela","type":"CHAPTER","typeName":"Rozdział","year":2022,"title":"Ryzyko i konsekwencje zaburzeń głosu występujących po chorobie COVID-19 oraz ich wpływ na pracę nauczyciela","otherTitles":[],"abstracts":[{"languageCode":"pol","content":"Poprawna emisja głosu jest warunkiem koniecznym do zaspokojenia jednej z podstawowych potrzeb człowieka – komunikacji. Dla wielu osób w wielu grupach zawodowych emisja głosu stanowi również zasadnicze narzędzie pracy. Aktorzy, lektorzy, politycy, mówcy, dziennikarze, a także nauczyciele narażeni są na częstą eksploatację głosu. Badania wskazują, że istnieje wysokie ryzyko wystąpienia zaburzeń gło- su właśnie w tej grupie zawodowej. Te nieprawidłowości stanowią nie tylko problem zdrowotny, ale również ekonomiczny, ponieważ aktywność zawodowa nauczycieli z problemami głosowymi może być znacząco ograniczona. W czasach pandemii koronawirusa dostrzeżono szereg powikłań w obszarze pracy krtani i fizjologii głosu po przechorowaniu COVID-19. Wirus może wnikać do wnętrza tkanek fałdów głosowych, doprowadzając do patologicznych stanów pracy w obrębie krtani. COVID-19 wpływa również negatywnie na wiele innych układów, które odpowiadają za proces tworzenia głosu (system oddechowy, układ nerwowy). Środowisko pracy nauczycieli nie sprzyja rekonwalescencji głosu. Pedagodzy często przemawiają w hałasie, narażeni są na stres, a sale lekcyjne nie spełniają sprzyjających warunków akustycznych. Nieleczone, zabu- rzenia krtani mogą zagrozić prawidłowej fizjologii głosu, doprowadzając nauczycieli do niemożności wykonywania swoich obowiązków zawodowych, zmuszając ich jednocze- śnie do rezygnacji z pracy. Badania wskazują jednak na wysoką skuteczność stosowania zasad higieny i terapii głosu w leczeniu dysfonii."}],"affiliations":[{"id":"5e70918b878c28a04737de42","uid":"b6wbLGqd2-hodtaiYCyr6xA","uuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","name":"Akademia Pedagogiki Specjalnej im. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["60c2fea39543c723365438ed"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","pagesFromTo":"51-66","contributionOrder":{"AUTHOR":["60c2fea39543c723365438ed"]},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"book":{"objectId":"634681654097075839144a5c","title":"Wybrane aspekty funkcjonowania rynku pracy w czasie pandemii COVID-19. Inspiracje dla pedagogiki","year":2022,"isbn":"9788366812833","url":"https://www.wydawnictwoscriptum.pl/wybrane-aspekty-funkcjonowania-rynku-pracy-w-czasie-pandemii-covid-19-inspiracje-dla-pedagogiki-p-386.html","translation":false,"documentHash":"92e64c54-cef4-4389-95ff-9694641def47","publisher":{"objectId":"5d6cb9bb878c284eaa45c8f7","mniswId":"65000","name":"Wydawnictwo \"scriptum\"","documentHash":"c70ca42f-4a04-4f42-8a56-391d289e7f65"},"bookEvaluation":{"scientificEdition":false,"translationToPolish":false,"translationFromPolish":false,"bookProjectNCN":false,"bookProjectFNP":false,"bookProjectNPHR":false,"bookProjectUE":false}},"keywords":[{"languageCode":"pol","keywords":["emisja głosu","nauczyciele","ryzyka zawodowe","zaburzenia głosu","COVID-19"]}],"lastRefresh":"1761904284392"},{"authors":[{"objectId":"6347782a7523402e3411cce4","name":"Julia","lastName":"Serwa","uuid":"8E044A0F096BD7EF940DD19B3A192810E0B4982CF58606598DB119E4D50B32FCC43A25B0ED5DDBDABDF2C9D2BA76BF93A269E494D78CCAD2718A86E901068D4A","orcidId":"0000-0003-2073-2260","documentHash":"c15b7795-5b1a-4d0b-a012-ed0aa25d70cb"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_ND","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"DECEMBER","releaseDateYear":2022},"objectId":"63bc5ed3409707548626e7cf","publicUri":"http://wse.home.amu.edu.pl/czasopisma_naukowe/konteksty/nr.php","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Komunikacja alternatywna i wspomagająca w procesie terapeutycznym młodzieży ze sprzężoną niepełnosprawnością – studium przypadku","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Alternative and supportive communication in the therapy of adolescents with multiple disabilities is an indispensable part of therapeutic work with non-verbal children. The article characterizes therapeutic interactions by means of alternative and supportive communication. The methodology of the author’s research is presented, and thus the subject, purpose and research problem of this article are formulated. The research was carried out by means of case descriptions of two girls. An analysis of observations of Helena’s and Blanca’s functioning is presented, and alternative and supportive communication methods in therapy are presented, and therefore the results of own research."}],"affiliations":[{"id":"5e70918b878c28a04737de42","uid":"b6wbLGqd2-hodtaiYCyr6xA","uuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","name":"Akademia Pedagogiki Specjalnej im. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["6347782a7523402e3411cce4"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"34","pagesFromTo":"39-56","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["6347782a7523402e3411cce4"]},"journal":{"objectId":"5e6f7d52878c285145479f0a","mniswId":"200268","title":"Interdyscyplinarne Konteksty Pedagogiki Specjalnej","issn":"2300-391X","eissn":"2300-391X","metadataSource":"ERIH","documentHash":"c5c0556b-92c5-447d-bb9a-2981523e0e51"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[],"lastRefresh":"1761904345838"},{"authors":[{"objectId":"63cfc7024097075010f7d71d","name":"Aleksandra","lastName":"Tłuściak-Deliowska","documentHash":"94fde550-a9f2-408a-83c4-2d3fd5885c9c"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_NC","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_REPOSITORY","releaseDateMonth":"JUNE","releaseDateYear":2022},"objectId":"63cfc7024097075010f7d71c","doi":"10.15804/tner.2022.69.3.08","publicUri":"http://dx.doi.org/10.15804/tner.2022.69.3.08","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Sense of Self-Efficacy and Helplessness Among Students of Higher Grades of Primary School During the COVID-19 Pandemic","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Learning in unknown circumstances is a great challenge for young people, particularly those who lack the ability to regulate their emotions. This text presents the results of research on the image of the life of students in higher grades of primary school, measured by the sense of self-efficacy and the sense of helplessness. The research was conducted during the COVID-19 pandemic among 303 students. It was found that (1) students rather express their belief in their own effectiveness (agency), and, at the same time, (2) half of the students indicated the feeling of helplessness; (3) helplessness is significantly higher among girls; (4) in the case of girls, there is a clear and strong negative relation between the sense of effectiveness and the helplessness."}],"affiliations":[{"id":"5e70918b878c28a04737de42","uid":"b6wbLGqd2-hodtaiYCyr6xA","uuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","name":"Akademia Pedagogiki Specjalnej im. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["63cfc7024097075010f7d71d"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"69","issue":"3","pagesFromTo":"107-118","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["63cfc7024097075010f7d71d"]},"journal":{"objectId":"5ec00332ad49b31cced6f4bd","title":"The New Educational Review","eissn":"1732-6729","websiteLink":"http://www.educationalrev.us.edu.pl/","documentHash":"46805800-c813-4c40-a951-be981f7bfe14"},"_version":4,"journalIssue":{"objectId":"63ce5bd24097072e2fc3b5e4","year":"2022","volume":"69","number":"3","doi":"","documentHash":"9fbf3de4-82f5-4493-9060-27de1324020f"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["sense of self-efficacy","helplessness","pandemic","students","primary school"]}],"lastRefresh":"1761904369202"},{"authors":[{"objectId":"5ebee585752340254fc44a30","name":"Iwona","lastName":"Nowakowska","uuid":"F8D58F52B4C3BFDA1DC9BF314032549AFC3C0751C5D4760528B5E534DEF9BBF1975D8940D21523BBDA371DD550A73C316127E9D66A322C26AFCF08441EF7D6F7","orcidId":"0000-0001-7701-5612","documentHash":"d262a22b-3141-487e-89b2-237a512390f0"},{"objectId":"5e70932e878c28a0473a47a8","name":"Irena","lastName":"Jelonkiewicz-Sterianos","uuid":"6BD1126D8EA8B7D5F2AA34D0E9EBDCAC061D4AA41EC81DF5590A28A1E5073789B5A87509D93CFA20E14BF672A81ABBAD3C36ADA67CD25790BF43BF746C9CED34","orcidId":"0000-0003-3942-2473","documentHash":"651b543e-fe35-4271-b811-55d881237935"}],"objectId":"63efbc364097075fda468958","doi":"10.1177/00332941221144607","publicUri":"http://journals.sagepub.com/doi/pdf/10.1177/00332941221144607","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"The Mediational Role of Future and Past Time Perspectives in the Relationship Between Negative Affectivity and Sense of Coherence","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Sense of coherence (SoC) can promote positive coping, and one of its most prominent negative correlates is negative affectivity (NA). In the current study, we hypothesized that future and past time perspectives (TPs) will mediate the relationship between sense of coherence and negative affectivity, and the inverse relationship. The study was questionnaire-based, performed online. N = 719 participants aged 25-45 from the general Polish population took part. On the correlation level, NA was negatively related to future and past positive TPs, and positively to past negative TP. Future and past positive TPs were positively related to SoC, whereas the past negative TP was related negatively to SoC. Future and past TPs partially mediated the effect of NA on SoC. The indirect effect was the strongest for past negative TP and very weak for future and past positive TPs. The full model accounted for 52.9% of variance in SoC. Only past negative TP mediated the relationship between SoC and NA. The full model accounted for 29.8% of variance in NA. The results may serve as an inspiration to integrate time perspective aspects within the salutogenic approaches to understanding human behavior and psychological interventions."}],"affiliations":[{"id":"5e70918b878c28a04737de42","uid":"b6wbLGqd2-hodtaiYCyr6xA","uuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","name":"Akademia Pedagogiki Specjalnej im. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["5ebee585752340254fc44a30","5e70932e878c28a0473a47a8"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","pagesFromTo":"3329412211446","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["5ebee585752340254fc44a30","5e70932e878c28a0473a47a8"]},"journal":{"objectId":"5e6f7d4f878c285145479426","mniswId":"16749","title":"Psychological Reports","issn":"0033-2941","eissn":"1558-691X","documentHash":"c486f2f3-8da9-4410-8b7c-654c8577aa2d"},"_version":4,"journalIssue":{"objectId":"63efbc364097075fda468959","year":"2022","documentHash":"fcadd04e-bc03-4041-9f56-9202cc2e5782"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[],"lastRefresh":"1761904385805"},{"authors":[{"objectId":"65605b1c4097073c06937809","name":"Kateryna","lastName":"Martynenko","documentHash":"5afd9456-a1b4-4e37-8b70-472d7b6b8316"},{"objectId":"65605b1c4097073c06937808","name":"Liubov","lastName":"Kravchenko","documentHash":"da77bde7-75af-4673-a3c7-b6d40ec38bd9"},{"objectId":"65605b1c4097073c06937807","name":"Tetiana","lastName":"Stoychik","documentHash":"53f3ab4f-96d4-4762-9f14-e2393ade38f4"},{"objectId":"65605b1c4097073c06937806","name":"Larysa","lastName":"Sergeieva","documentHash":"67431293-b4ce-44ac-8ee4-3578f0b696e9"},{"objectId":"65605b1c4097073c06937805","name":"Iryna","lastName":"Androshchuk","documentHash":"95d11f2e-ff4a-4734-b70e-9af741d253c7"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_NC","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_REPOSITORY","releaseDateMonth":"JUNE","releaseDateYear":2023},"objectId":"65605b1c4097073c06937804","doi":"10.15804/tner.23.72.2.05","publicUri":"http://dx.doi.org/10.15804/tner.23.72.2.05","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Quality Control Modelling of Competitive Professionals’ Training at Vocational Education Institutions","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"The most important condition that provides the opportunity for the professionalism of professionals is their competitiveness. The current task of institutions of professional (vocational technical) education (IP(VT)E) is to prepare a qualified and competitive specialist who not only has a certain level of knowledge, skills and abilities but can practically apply them in their professional activities. Future specialists’ training quality is based on the ability to adapt to rapidly changing production conditions. It is due both to the prospect of Ukraine’s accession to the European Union and to the internal situation in the country, where a large number of applicants in IP(VT)E and institutions of professional higher education (IPHE) do not always meet the requirements of the labour market. It requires resetting educational goals and objectives of vocational education, considering global changes in society, production, and technology. This article aims to substantiate the quality management model of training competitive specialists in IP(VT)E, considering the factors affecting the quality of training and contradictions that need to be resolved in the training process and experimental verification of its effectiveness. A set of theoretical and empirical methods was used to create a model and test its effectiveness, identifying the components that have become key in creating a model of quality management training for future competitive professionals in vocational education institutions. To determine the effectiveness, a set of questionnaires was developed, and within the framework of the pedagogical experiment, a section was conducted among entrants, applicants, graduates, pedagogical workers, heads of IP(VT)E regions of Ukraine, and employers, the results were analysed."}],"affiliations":[{"id":"65605b1c4097073c0693780a","name":"Kryvyi Rih Professional Mining and Technology Lyceum","affiliatedPersonIDs":["65605b1c4097073c06937807","65605b1c4097073c06937809"],"type":"AUTHOR"},{"id":"61eab9f32467f06f09e38571","name":"University of Educational Management","affiliatedPersonIDs":["65605b1c4097073c06937806"],"type":"AUTHOR"},{"id":"628cc2064097074a658ce829","name":"Municipal Institution of Higher Education «Dnipro Academy of Continuing Education» Dnipropetrovsk Regional Council","affiliatedPersonIDs":["65605b1c4097073c06937808"],"type":"AUTHOR"},{"id":"5e70918b878c28a04737de42","uid":"b6wbLGqd2-hodtaiYCyr6xA","uuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","name":"Akademia Pedagogiki Specjalnej im. Marii Grzegorzewskiej w Warszawie","affiliatedPersonIDs":["65605b1c4097073c06937805"],"parentId":"5e70918b878c28a04737de42","parentUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","rootId":"5e70918b878c28a04737de42","rootUuid":"e45fc816-fbf4-4e46-adfa-89c07c084f45","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"72","issue":"2","pagesFromTo":"66-83","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["65605b1c4097073c06937805","65605b1c4097073c06937806","65605b1c4097073c06937807","65605b1c4097073c06937808","65605b1c4097073c06937809"]},"journal":{"objectId":"5e6f7d4e878c28514547901c","mniswId":"25156","title":"New Educational Review","issn":"1732-6729","metadataSource":"IMPORT","documentHash":"85dcf5fa-2a8b-43f0-a05a-680bbc17f511"},"_version":4,"journalIssue":{"objectId":"65e44d8840970757aaa0b69a","year":"2023","volume":"72","nu