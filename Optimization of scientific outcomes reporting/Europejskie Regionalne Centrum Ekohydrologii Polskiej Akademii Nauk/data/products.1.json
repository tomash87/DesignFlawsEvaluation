do każdej z rur (5) przymocowane są, za pomocą zaplecenia i nitowania, pasy (6) wykonane z polichlorku winylu (PCW). Na skarpie komory umiejscowione są lampy doświetlające (7) komorę.","publicationNumber":"245948","productTitles":[{"code":"polski","value":"Komora intensywnego podczyszczania wód płynących"},{"code":"angielski","value":"Intensive pretreatment chamber for flowing waters"}],"protectionType":"Patent na wynalazek","protectionUuid":"2CA1F3EE982964BC474C3D5810C045E2","lastRefresh":"1763518004882","priorityClaimDate":null,"grantingInstitutionCountry":null,"dataSource":"POLON","applicationDate":"2020-09-17"},{"protectionRegionCode":"33","protectionRegion":"Polska","priorityExhibitionNumber":null,"grantingInstitutionCode":"3","applicationNumber":"426509","plantBotanicName":null,"inventors":[{"relatedInstitutionUuid":"f00818c2-d557-4d92-b38f-db41eb6a8c0f","relatedInstitutionName":"Europejskie Regionalne Centrum Ekohydrologii Polskiej Akademii Nauk","persons":[{"employeeId":"5DC0030AD66D5915A4666C4F322C64BCE5742025","firstName":"Edyta","relatedFirstName":"Edyta","middleName":"Anna","relatedMiddleName":"Anna","lastName":"Kiedrzyńska","relatedLastName":"Kiedrzyńska","relatedOrcid":"0000-0003-0649-4438","evaluationStatement":[{"disciplineCode":"DS010603N","disciplineName":"nauki biologiczne","institutionUuid":"f00818c2-d557-4d92-b38f-db41eb6a8c0f","institutionName":"Europejskie Regionalne Centrum Ekohydrologii Polskiej Akademii Nauk"}]},{"employeeId":null,"firstName":"Agnieszka","relatedFirstName":null,"middleName":null,"relatedMiddleName":null,"lastName":"Bednarek","relatedLastName":null,"relatedOrcid":null,"evaluationStatement":[]},{"employeeId":null,"firstName":"Marcin","relatedFirstName":null,"middleName":null,"relatedMiddleName":null,"lastName":"Kiedrzyński","relatedLastName":null,"relatedOrcid":null,"evaluationStatement":[]},{"employeeId":"5D986AFBB70F490B68808B18B6F5C2B59E5AC581","firstName":"Joanna","relatedFirstName":"Joanna","middleName":null,"relatedMidd