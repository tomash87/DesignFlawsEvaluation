tutionUuid":"f00818c2-d557-4d92-b38f-db41eb6a8c0f","institutionName":"EUROPEJSKIE REGIONALNE CENTRUM EKOHYDROLOGII POLSKIEJ AKADEMII NAUK","higherEducationInstitutionMarker":"true","higherEducationInstitutionName":"Europejskie Regionalne Centrum Ekohydrologii Polskiej Akademii Nauk"}]}],"priorityNumber":null,"relatedInstitutions":[{"institutionUuid":"5011bcd5-dfb1-41ed-84b0-5bd51ce0832c","institutionName":"Uniwersytet Łódzki"},{"institutionUuid":"f00818c2-d557-4d92-b38f-db41eb6a8c0f","institutionName":"Europejskie Regionalne Centrum Ekohydrologii Polskiej Akademii Nauk"}],"plantVarietyNames":[],"priorityApplicationNumberUPRP":null,"priorityRegion":null,"plantSpeciesNames":[],"priorityFirstApplication":"true","protectionTitle":"Sekwencyjny system biofiltracji ścieków","publicationDate":"2022-10-10","grantingInstitutionName":"Urząd Patentowy Rzeczpospolitej Polskiej","dateSubmissionTranslation":null,"protectionTypeCode":"1","productDescription":"Przedmiotem wynalazku jest sekwencyjny system biofiltracji ścieków dedykowany do doczyszczania ścieków odprowadzanych z małych oczyszczalni komunalnych poniżej 2000 RLM. Sekwencyjny system biofiliracji ścieków składa się z następujących po sobie stref, z których pierwsza to strefa redukcji zawiesiny (1) stanowiąca kaskadowy system komór sedymentacyjno - retencyjnych. Kolejna to strefa redukcji związków fosforu (II) stanowiąca sekwencyjny system złóż wapienno - keramzytowych zaopatrzonych w system regeneracji złoża oraz zieloną strefę makrofitowo - wierzbową. Kolejna strefa redukcji związków azotu stanowi sekwencyjny system złóż węglowo - keramzytowych, zaopatrzonych w system przegród spowalniających przepływ ścieków oraz system zawiesin aktywowanych mikrobiologicznie. Ostatnia to strefa redukcji związków fosforu, azotu, dioksyn i związków dioksynopodobnych stanowiąca sekwencyjny system biodegradowalnych mat makrofitowych.","publicationNumber":"241486","productTitles":[{"code":"angielski","value":"Sequential biofiltration syste