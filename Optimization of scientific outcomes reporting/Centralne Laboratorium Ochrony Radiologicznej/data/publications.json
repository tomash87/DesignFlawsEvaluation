[{"authors":[{"objectId":"639c34bf409707327115be55","name":"Barbara","lastName":"Rubel","documentHash":"3ff4164f-f9e7-4b5b-b8de-b976e46e79f2"},{"objectId":"639c34bf409707327115be53","name":"Małgorzata","lastName":"Kardaś","documentHash":"bd8ce4fe-0d73-483a-a851-4d140aea4115"},{"objectId":"5ebed945752340254fc4137a","name":"Karol","lastName":"Wiatr","uuid":"C89FEE18A0C82AC84011F001752885305C86F5C2A92F21CC31752BE12E7BFFF428F95D4D35ADB98EAA5EE4870AA928BD3FC982F7301701FB2FA9739E62683F4D","orcidId":"0000-0003-1072-6430","documentHash":"8c14fa0a-de71-448d-a47c-544a103153cd"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_NC_ND","releaseDate":"2022-12-05","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"639c34bf409707327115be51","doi":"10.2478/nuka-2022-0006","publicUri":"https://doi.org/10.2478/nuka-2022-0006","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Rapid 90Sr quantification method based on the Bateman equation for routine laboratory work","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Artificially introduced into the environment Sr-90 is highly radiotoxic, so its content levels in foodstuff\nand biota require constant monitoring for radiological protection. Most analytical procedures used for Sr-90 determination\nare time-consuming, and therefore, a faster approach is needed. Employing the Bateman equation\nenables more effi cient exploitation of the secular equilibrium between Sr-90 and its daughter radionuclide Y-90 in\nthe calculations. This article describes a method for computing the Sr-90 activity concentration, while accounting\nfor Y-90 activity. The developed approach was tested and validated in terms of its applicability in everyday analysis."}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["639c34bf409707327115be53","639c34bf409707327115be55","5ebed945752340254fc4137a"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"67","issue":"4","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5ebed945752340254fc4137a","639c34bf409707327115be55","639c34bf409707327115be53"]},"journal":{"objectId":"5e6f7d4e878c285145479087","mniswId":"15250","title":"Nukleonika","issn":"0029-5922","eissn":"1508-5791","documentHash":"870d17b8-1114-46c6-85d4-201fc05f05c8"},"_version":4,"journalIssue":{"objectId":"639c34bf409707327115be52","year":"2022","volume":"0","number":"0","documentHash":"a07957fc-9a1b-4973-98a3-978fbd91839e"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["Bateman equation • Liquid scintillation • Strontium-90 • Yttrium-90"]}],"lastRefresh":"1761904319031"},{"authors":[{"objectId":"5e7094d7878c28a0473c51c0","name":"Barbara","lastName":"Piotrowska","uuid":"99EDF62FA6951FD3699F2394E68FEE9CB0E0FFD01689A46CDC85D90DA7A05BD0F7E279C4D685A8691173BD74D4362D1A525933E0255B18256A78B6EFB28AB1F0","orcidId":"0000-0001-5121-9027","documentHash":"684facf4-1cab-4580-84d4-8cb9393831f8"},{"objectId":"5e709498878c28a0473c0158","name":"Olga","lastName":"Stawarz","uuid":"01A3B8D88D4968A594AAEDE21219A62A79338615532221032C25E181BF03EF0EEAB36D5F6E3D38ABCE5923A5E43C344CE48F72AB9DA89FFB530A37353CEBFC8A","orcidId":"0000-0003-4725-5206","documentHash":"6b4f5f19-9557-41a6-bb1c-e2c1c5fcc403"},{"objectId":"5e709410878c28a0473b59b8","name":"Krzysztof","lastName":"Isajenko","uuid":"FA1A04876E3CA106165704C402C5BAB51732DA5806A1B43B5C0C7AC62D112BBAF63D7211DABCDC9B640DBD9E434F72673F7700CF8A403919F3CA57AAD7AA24AB","orcidId":"0000-0002-9437-3988","documentHash":"596e3624-f05c-4602-9d9d-deb4826b82fe"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY","releaseDateMode":"BEFORE_PUBLICATION","mode":"OPEN_REPOSITORY","releaseDateMonth":"DECEMBER","releaseDateYear":2022},"objectId":"63ad5a8e40970728ba31ac18","doi":"10.5281/zenodo.7463221","publicUri":"https://zenodo.org/record/7463221#.Y7aFbXbMJPY","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Promieniotwórczość gleb Ojcowskiego Parku Narodowego","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"This work presents the results of the determination of caesium Cs-137 deposition and concentrations of potassium K-40, radium Ra-226 and actinium Ac-228 in soil samples collected in Ojców National Park by CLOR. Concentration measurements were taken by gamma radiation spectrometry using a spectrometric track with a coaxial HPGe detector. Exposure of people to ionizing radiation in Ojców National Park was estimated on the basis of natural radionuclide concentrations in soil samples. In addition, the obtained determinations of caesium deposition and concentrations of natural radionuclides in the soil were compared with the results of research conducted by CLOR in several other National Parks in our country and also for Poland and Małopolskie Voivodeship (CLOR radiological monitoring carried out cyclically since 1988, study for the Chief Inspectorate of Environmental Protection)."}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5e709410878c28a0473b59b8","5e709498878c28a0473c0158","5e7094d7878c28a0473c51c0"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"32","pagesFromTo":"9-24","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709498878c28a0473c0158","5e709410878c28a0473b59b8","5e7094d7878c28a0473c51c0"]},"journal":{"objectId":"61b9ac1bad204581b62ebb83","mniswId":"201344","title":"Prądnik. Prace i materiały Muzeum im. Prof. Władysława Szafera","issn":"0867-0196","documentHash":"e8573575-220b-4ffe-b60a-fa9dc301824b"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["soil radioactivity, Ojcowski National Park, gamma spectrometry, 137Cs, 40K, 226Ra, 228Ac, Chernobyl NPP"]}],"lastRefresh":"1761904328525"},{"authors":[{"objectId":"5e709496878c28a0473bff6e","name":"Katarzyna","lastName":"Wołoszczuk","uuid":"7F18754C05767FA1C607856E3C94104DC5B9D328246D1895223A10785742955CC7DD9E6B76B5FD0465A4BB3F5D3D0895AE9201FFBA416A81834EBCE34E5E25CA","orcidId":"0000-0002-6380-2241","documentHash":"58994b09-fc4d-49d0-8932-4f254e99ab24"},{"objectId":"5e70937d878c28a0473aaf8f","name":"Agata","lastName":"Grygier","uuid":"CDE736D67ECF31D6A462454D621A8E502249195DD80F3C687D4807780F9ED0F18EB0670A6639AF4FFB389DC915BF088303B62E72C9D7789E88649F7DEEDF956F","documentHash":"13602885-c6c5-4272-99e7-6b5ce503eef1"},{"objectId":"5e70929d878c28a0473992ed","name":"Krzysztof","lastName":"Samolej","uuid":"F92EE33C271B267CBA078B05A1072A624E3226CDB0A466168BEEE386A291C2C38D3A8DE6DF24EDF5EC44CBBAD0D214A8F3EE02C5ED0318827702BED28B89596F","orcidId":"0000-0002-0867-7556","documentHash":"faeda32a-e734-460b-a851-92e17ed1e95f"},{"objectId":"5e709284878c28a0473970ee","name":"Krystian","lastName":"Skubacz","uuid":"FC68B5C67B2F7613EFAA00230CF6C0DC5E555CB3B1BAFBD66B5A71AF131C75E8C4B0024285A021C0FA7B3A7619624CFEFD9FDF037F31FC9A60972E364FD58E2B","orcidId":"0000-0001-6858-7774","documentHash":"06be3b9d-c9ab-4edd-86b6-dbac71471499"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY","releaseDate":"2023-04-12","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"643fa48e4097073cb6986fc1","doi":"10.3390/ijerph20085482","publicUri":"https://www.mdpi.com/1660-4601/20/8/5482","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Influence of Dose Conversions, Equilibrium Factors, and Unattached Fractions on Radon Risk Assessment in Operating and Show Underground Mines","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"This paper compares the results of measurements taken in the underground workings of active and tourist mines. In these facilities, the aerosol size distributions of ambient aerosols at key workplaces and the distributions of radioactive aerosols containing radon decay products were determined. Based on these studies, dose conversions used for dose assessment and unattached fractions were determined. In addition, radon activity concentrations and potential alpha energy concentrations of short-lived progeny were also measured in the mines to determine the equilibrium factor. The dose conversions varied between 2–7 mSv/(mJ × h × m−3). The unattached fraction measured in active coal mines ranged from 0.01–0.23, in tourist mines from 0.09–0.44, and in the tourist cave it was 0.43. The results showed significant discrepancies between the effective doses determined from current recommendations and legal regulations and those determined from direct measurements of parameters affecting exposure."}],"affiliations":[{"id":"5e70918b878c28a04737decd","uid":"bDVT6eE951oVevqx9vwsANA","uuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","name":"Główny Instytut Górnictwa - Państwowy Instytut Badawczy","affiliatedPersonIDs":["5e709284878c28a0473970ee","5e70937d878c28a0473aaf8f","5e70929d878c28a0473992ed"],"parentId":"5e70918b878c28a04737decd","parentUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","rootId":"5e70918b878c28a04737decd","rootUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","type":"AUTHOR"},{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5e709496878c28a0473bff6e"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"20","issue":"8","pagesFromTo":"Artykuł nr 5482","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709284878c28a0473970ee","5e709496878c28a0473bff6e","5e70937d878c28a0473aaf8f","5e70929d878c28a0473992ed"]},"journal":{"objectId":"5e6f7d4c878c2851454781e9","mniswId":"8892","title":"International Journal of Environmental Research and Public Health","issn":"1661-7827","eissn":"1660-4601","metadataSource":"SCOPUS","documentHash":"e236e16e-7430-4ac3-800c-033637860e22"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["radon hazards","underground active and show mines","cave","evaluation of dose conversion","unattached fraction","equilibrium factors","assessment of effective dose"]}],"lastRefresh":"1761904436563"},{"authors":[{"objectId":"659fa38a40970707a127a27d","name":"Koleta","lastName":"Kurek","documentHash":"9c4f0af2-3575-4583-ab74-9fb44f3763bf"},{"objectId":"5e7094d7878c28a0473c51c0","name":"Barbara","lastName":"Piotrowska","uuid":"99EDF62FA6951FD3699F2394E68FEE9CB0E0FFD01689A46CDC85D90DA7A05BD0F7E279C4D685A8691173BD74D4362D1A525933E0255B18256A78B6EFB28AB1F0","orcidId":"0000-0001-5121-9027","documentHash":"684facf4-1cab-4580-84d4-8cb9393831f8"},{"objectId":"5e709498878c28a0473c0158","name":"Olga","lastName":"Stawarz","uuid":"01A3B8D88D4968A594AAEDE21219A62A79338615532221032C25E181BF03EF0EEAB36D5F6E3D38ABCE5923A5E43C344CE48F72AB9DA89FFB530A37353CEBFC8A","orcidId":"0000-0003-4725-5206","documentHash":"6b4f5f19-9557-41a6-bb1c-e2c1c5fcc403"},{"objectId":"5e709410878c28a0473b59b8","name":"Krzysztof","lastName":"Isajenko","uuid":"FA1A04876E3CA106165704C402C5BAB51732DA5806A1B43B5C0C7AC62D112BBAF63D7211DABCDC9B640DBD9E434F72673F7700CF8A403919F3CA57AAD7AA24AB","orcidId":"0000-0002-9437-3988","documentHash":"596e3624-f05c-4602-9d9d-deb4826b82fe"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"OTHER","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"DECEMBER","releaseDateYear":2023},"objectId":"659fa38a40970707a127a27c","publicUri":"https://www.gov.pl/attachment/2eed2916-890a-4113-b095-b13b765224c1","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Stacje ASS-500 jako główny element sieci monitoringu radiologicznego powietrza w Polsce","otherTitles":[],"abstracts":[{"languageCode":"pol","content":"Radiologiczny monitoring powietrza atmosferycznego w Polsce realizowany jest od ponad 30 lat m.in. przez sieć stacji ASS-500 rozmieszczonych obecnie w 13 lokalizacjach na terenie całego kraju. Właścicielem wszystkich stacji ASS-500 w Polsce jest Centralne Laboratorium Ochrony Radiologicznej (CLOR). CLOR nadzoruje pracę sieci na podstawie umowy z Prezesem Państwowej Agencji Atomistyki. Wyniki pomiarów spektrometrycznych aerozoli powietrza atmosferycznego zgromadzonych na filtrach eksponowanych w stacjach przesyłane są do CLOR, a następnie opracowywane w formie sprawozdań\nmiesięcznych, kwartalnych i rocznych. Równolegle prowadzona jest internetowa baza danych, zawierająca wszelkie istotne informacje o próbkach i rezultatach badań. Dzięki wykonywanym pomiarom i szacowaniu dawek możliwe jest poznanie zagrożeń dla zdrowia ludzi. Stały nadzór nad siecią stacji umożliwia także uzyskanie informacji zmierzających do wykrycia źródła różnych\nzdarzeń radiacyjnych, jakie mogły wystąpić w Europie czy na całym świecie.\nW pracy przedstawiono ogólne informacje dotyczące pracujących w sieci wczesnego wykrywania skażeń promieniotwórczych w powietrzu stacji ASS-500, a także opis stacji mobilnych, takich jak: stacja do poboru aerozoli z powietrza atmosferycznego, stacja do poboru jodu w postaci gazowej i stacja do poboru gazów szlachetnych, równie ważnych do oceny poziomu radioaktywności powietrza. Dodatkowo przytoczono kilka przykładów zdarzeń radiacyjnych, które zostały zarejestrowane przez\nstacje ASS-500."}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5e709410878c28a0473b59b8","5e709498878c28a0473c0158","5e7094d7878c28a0473c51c0"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"130","issue":"4","pagesFromTo":"49-56","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709410878c28a0473b59b8","5e7094d7878c28a0473c51c0","5e709498878c28a0473c0158","659fa38a40970707a127a27d"]},"journal":{"objectId":"61b9abddad204581b62eba07","mniswId":"201085","title":"Bezpieczeństwo Jądrowe i Ochrona Radiologiczna","issn":"0867-4752","eissn":"2353-9062","metadataSource":"MINISTRY","documentHash":"4da78035-12ea-4c2b-9e68-3e1bc23446aa"},"_version":4,"journalIssue":{"objectId":"6582ba5c40970751d8eebb2a","year":"2023","number":"4","documentHash":"7f75a9d3-06df-4d9c-a0e1-770fecc7d2a6"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"pol","keywords":["Monitoring radiologiczny","aerozole powietrza","stacja ASS-500","zdarzenie radiacyjne","gazy szlachetne","jod gazowy"]}],"lastRefresh":"1761904694036"},{"authors":[{"objectId":"65cb5ab04097072cdd77666e","name":"Anna","lastName":"Wieczorek","documentHash":"6b72bc6b-a37e-43dd-9618-41589c4397a3"},{"objectId":"65cb5ab04097072cdd77666d","name":"Patryk","lastName":"Maik","documentHash":"3c870a63-2c15-48e5-8195-c3f6ce5980d6"},{"objectId":"65cb5ab04097072cdd77666c","name":"Łukasz","lastName":"Szklarski","documentHash":"9e800521-6896-4764-87d3-dfa50a2de3c4"},{"objectId":"5ebeddc6752340254fc42776","name":"Alicja","lastName":"Jakubowska","uuid":"E67394D96D38086F0AD04056D1D84667DDDA66CED2B6D670C733962A5DDB8D9FF58989BAFC0BA191EF4660DA85FD449A6E5A1343526C4F3AC4C884A2F7028A0E","orcidId":"0000-0002-5266-8999","documentHash":"86bded92-4328-4de3-8779-6d28c24bfde7"},{"objectId":"5e709496878c28a0473bff6e","name":"Katarzyna","lastName":"Wołoszczuk","uuid":"7F18754C05767FA1C607856E3C94104DC5B9D328246D1895223A10785742955CC7DD9E6B76B5FD0465A4BB3F5D3D0895AE9201FFBA416A81834EBCE34E5E25CA","orcidId":"0000-0002-6380-2241","documentHash":"58994b09-fc4d-49d0-8932-4f254e99ab24"},{"objectId":"5e709407878c28a0473b515d","name":"Paweł","lastName":"Krajewski","uuid":"9A2287E0C670CF51AC5AC38B3839B36D3F69AB52147A1C754602907A8DCB025607CE292ADEDF50F364FADCF42C0D16F35D39ACAF062B54BF76E414359111F85F","orcidId":"0000-0001-6011-2328","documentHash":"e95ea93d-1f56-4be8-a44a-aa2d27e4827d"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"DECEMBER","releaseDateYear":2023},"objectId":"65cb5ab04097072cdd77666a","publicUri":"http://www.ichtj.waw.pl/ptj/Pliki/ptj2023no4.pdf","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Metody pomiaru promieniowania i identyfikacji nuklidów w zdarzeniach CBRN: analiza badawcza z projektu EU-RADION","otherTitles":[{"languageCode":"eng","title":"Methods for Radiation Measurements and Radionuclide Identification in CBRN Events: Insights from the EU-RADION Project Research"}],"abstracts":[{"languageCode":"pol","content":"Praca wyznacza implikacje zdarzeń radiologicznych w scenariuszach przemysłowych i terrorystycznych, wykorzystując wnioski z projektu EU-RADION i gruntownego przeglądu literatury. Wyniki podkreślają konieczność skutecznej ochrony przed promieniowaniem i środków reagowania w nagłych przypadkach, podkreślając kluczową rolę postępu technologicznego we wzmacnianiu zdolności wykrywania i zarządzania zagrożeniami radiologicznymi. Badanie podkreśla znaczenie trwających badań naukowych i międzynarodowej współpracy w umacnianiu globalnej odporności na zagrożenia radiologiczne."},{"languageCode":"eng","content":"This study delineates the implications of radiological events in industrial and terroristic scenarios, utilizing insights\nfrom the EU-RADION project and a thorough review of existing literature. The findings highlight the necessity for robust radiation protection and emergency response measures, underlining the pivotal role of technological advancements in enhancing radiological threat detection and management capabilities. The study underscores the significance of ongoing research and international collaboration in bolstering global resilience against radiological hazards"}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5ebeddc6752340254fc42776","5e709407878c28a0473b515d","5e709496878c28a0473bff6e"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"},{"id":"65cb5ab04097072cdd77666f","name":"ITTI sp. z o.o.","affiliatedPersonIDs":["65cb5ab04097072cdd77666e","65cb5ab04097072cdd77666d","65cb5ab04097072cdd77666c"],"type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"66","issue":"4","pagesFromTo":"2-17","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["65cb5ab04097072cdd77666c","5ebeddc6752340254fc42776","65cb5ab04097072cdd77666d","5e709496878c