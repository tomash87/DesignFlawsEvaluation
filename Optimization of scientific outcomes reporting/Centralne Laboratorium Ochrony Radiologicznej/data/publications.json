me":"Pawłowska","uuid":"D410DAC1F52769CF3589A407BE8A783D2EAC3482EA646945C295B23DF95C778F24849C555FCF660670221C63DFBFEF94F6FE1A2A77B7080153CED68CCF50B785","orcidId":"0000-0002-8787-2260","documentHash":"445a3da6-1c9a-4288-bfab-a90dea99636f"},{"objectId":"5e70937d878c28a0473aaf8f","name":"Agata","lastName":"Grygier","uuid":"CDE736D67ECF31D6A462454D621A8E502249195DD80F3C687D4807780F9ED0F18EB0670A6639AF4FFB389DC915BF088303B62E72C9D7789E88649F7DEEDF956F","documentHash":"13602885-c6c5-4272-99e7-6b5ce503eef1"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"OTHER","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"JULY","releaseDateYear":2024},"objectId":"66b1d44efdbe837cbff62b8f","publicUri":"https://www.gov.pl/web/paa/biuletyn-bezpieczenstwo-jadrowe-i-ochrona-radiologiczna-22024","type":"ARTICLE","typeName":"Artykuł","year":2024,"title":"Dostępne rozwiązania techniczne służące ograniczaniu stężeń radonu","otherTitles":[{"languageCode":"eng","title":"Technical solutions available to reduce radon concentrations"}],"abstracts":[{"languageCode":"pol","content":"Artykuł przedstawia dostępne rozwiązania techniczne służące ograniczaniu stężeń radonu w budynkach mieszkalnych. Omówiono różnorodne metody, takie jak uszczelnianie fundamentów, zastosowanie materiałów izolacyjnych, systemy wentylacji mechanicznej oraz depresuryzacji podpodłogowej. Podkreślono znaczenie identyfikacji źródeł radonu oraz wyboru odpowiednich technik w zależności od specyfiki budynku i warunków geologicznych. Szczególną uwagę zwrócono na metody prewencyjne stosowane na etapie projektowania i budowy nowych obiektów, jak również na techniki adaptacyjne w istniejących konstrukcjach. Wyniki badań potwierdzają, że skuteczne obniżenie stężeń radonu wymaga kompleksowego podejścia, łączącego różne techniki zabezpieczające."},{"languageCode":"eng","content":"The article presents technical solutions for reducing radon concentrations in residential buildings. Various methods are discussed, including foundation sealing, insulating materials, mechanical ventilation systems, and sub-slab depressurization. Identifying radon sources and selecting appropriate techniques based on building specifics and geological conditions is emphasized. Special attention is given to preventive measures implemented during the design and construction phases of new buildings, as well as adaptive techniques in existing structures. The research results confirm that effective radon concentration reduction requires a comprehensive approach that combines different protective techniques."}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5ebeddc6752340254fc42776","619477387523400e6372643f","5e7093f0878c28a0473b3987","5e709496878c28a0473bff6e"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"},{"id":"5e70918b878c28a04737decd","uid":"bDVT6eE951oVevqx9vwsANA","uuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","name":"Główny Instytut Górnictwa - Państwowy Instytut Badawczy","affiliatedPersonIDs":["5e70937d878c28a0473aaf8f"],"parentId":"5e70918b878c28a04737decd","parentUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","rootId":"5e70918b878c28a04737decd","rootUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","issue":"2","pagesFromTo":"7-13","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["5e7093f0878c28a0473b3987","5e70937d878c28a0473aaf8f","5e709496878c28a0473bff6e","619477387523400e6372643f","5ebeddc6752340254fc42776"]},"journal":{"objectId":"61b9abddad204581b62eba07","mniswId":"201085","title":"Bezpieczeństwo Jądrowe i Ochrona Radiologiczna","issn":"0867-4752","eissn":"2353-9062","metadataSource":"MINISTRY","documentHash":"4da78035-12ea-4c2b-9e68-3e1bc23446aa"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[{"languageCode":"pol","keywords":["Radon","uszczelnianie fundamentów","wentylacja mechaniczna","depresuryzacja podpodłogowa","materiały izolacyjne"]},{"languageCode":"eng","keywords":["Radon","foundation sealing","mechanical ventilation","sub-slab depressurization","insulating materials"]}],"lastRefresh":"1761904925539"},{"authors":[{"objectId":"688772defdbe831bcb018d62","name":"Małgorzata","lastName":"Kardaś","documentHash":"6373e239-ac51-4c9c-9d43-9feca32a8fd0"},{"objectId":"688772defdbe831bcb018d61","name":"Małgorzata","lastName":"Dziubałtowska","documentHash":"331daaff-43dd-4ff0-aa39-b3d7a7055b64"},{"objectId":"619477387523400e6372643b","name":"Małgorzata","lastName":"Kazimierowicz","uuid":"137A8FA7226FB254FFDE3878E070EFCE67B214AFC0BA56721E34FD544D3137A3249F8425CADC3A4FE84F30C655E250CECB1CC4AA2F5080FCE3C629251B49E605","orcidId":"0009-0007-4291-4408","documentHash":"3841da29-2fe0-4142-96c0-0cc76359c80f"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"OTHER","releaseDate":"2025-06-24","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"688772defdbe831bcb018d60","doi":"10.5604/01.3001.0055.1720","publicUri":"https://doi.org/10.5604/01.3001.0055.1720","type":"ARTICLE","typeName":"Artykuł","year":2025,"title":"RADIOACTIVE CONCENTRATIONS OF SR-90 AND CS-137 IN THE DIET OF POLISH RESIDENTS OVER FIVE YEARS: 2020–2024","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"The nuclides examined in this study, Sr-90 and Cs-137, are artificial radioactive isotopes, and their\npresence in the European environment is primarily associated with radioactive fallout from the 1986\nChernobyl disaster. Since ingestion is one of the main pathways for the intake of radioisotopes into\norganisms, the radioactive concentrations of Sr-90 and Cs-137 in the diet of Polish residents were\nstudied. To estimate the intake of Sr-90 and Cs-137 through food, their levels in daily meals were\nmeasured annually in Warsaw, the capital city of Poland. The radioactive concentrations measured\nranged from 0.03 to 0.07 Bq/day for Sr-90 and from 0.06 to 0.23 Bq/day for Cs-137. The combined\neffective doses from Sr-90 and Cs-137 varied between 0.69 and 1.60 μSv/year."}],"affiliations":[{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["619477387523400e6372643b","688772defdbe831bcb018d62","688772defdbe831bcb018d61"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"94","issue":"I","pagesFromTo":"177-190","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["619477387523400e6372643b","688772defdbe831bcb018d61","688772defdbe831bcb018d62"]},"journal":{"objectId":"61b9abfaad204581b62ebafd","mniswId":"201143","title":"Zeszyty Naukowe SGSP","issn":"0239-5223","documentHash":"3c49c206-084e-4c9f-b620-eba5a938f579"},"_version":4,"journalIssue":{"objectId":"6874e4d2fdbe832d0cb3192f","year":"2025","volume":"1","number":"94","documentHash":"1325187e-750f-478b-8e52-10dac8c2efdb"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"pol","keywords":["radiocez","radiostront","monitoring środowiska"]},{"languageCode":"eng","keywords":["strontium","cesium","diet","environmental radioactivity","radionuclides in diet"]}],"lastRefresh":"1761905419524"},{"authors":[{"objectId":"686ce01cfdbe8331796e5592","name":"Sergii","lastName":"Ubizskii","documentHash":"dbb6ee2c-f490-4038-97a0-b12c3e27ab94"},{"objectId":"686ce01cfdbe8331796e5591","name":"Oleksandr","lastName":"Poshyvak","documentHash":"958fb016-2aed-4e38-83f0-b4b17fbc94e5"},{"objectId":"684cdea9ece39852c2ed33b8","name":"Vasyl","lastName":"Stasiv","uuid":"400C4C681935EBC871D0066ECEF2DEB0363EC1BC9376827C24E4C422846EC548C2DCF31E89DDFDAD83168D582F727082FF4CCA979E5CB61B9813F834BEFC253A","documentHash":"17c3028a-6691-4b81-950b-cdb012853679"},{"objectId":"67b6f108ece398373d08b7da","name":"Halyna","lastName":"Zhydachevska","uuid":"84BDAF787973B8EA23B17EC5C60DA714552C9A22C7164DE05E78F09D16C63B2C5DEF8083323A1371854719D2484208ED267CBD7BF171E559335A269EC0A7038C","documentHash":"05baa303-748c-434f-9b22-719b62169126"},{"objectId":"62737c357523402064564fd4","name":"Yuliia","lastName":"Rumiantseva","uuid":"B9FC251B8B470E4CEF458CB50A28C85BCAE9C864196E59945FAFCD6093A757CAE7037C2760E6FB83E590449A9B505078330AD754D564A0C13A7881D331E8D256","documentHash":"d9bb7c90-973e-4f18-845c-bed6e58035e1"},{"objectId":"5e7093fb878c28a0473b455f","name":"MAGDALENA","lastName":"BARAN","uuid":"55202BCF343698CB7766EFC3D265CE139E44F362E84011525DBBCEB06633F232E9180A8CA78FB6B856116B4F3B49E57CFC03A9C1C6FDD0C8CD5E528A484A0847","orcidId":"0000-0003-4890-8280","documentHash":"f7c8143f-bbdc-4f1e-a208-21fa5b3c8ff9"},{"objectId":"5e7093f0878c28a0473b3987","name":"Zuzanna","lastName":"Pawłowska","uuid":"D410DAC1F52769CF3589A407BE8A783D2EAC3482EA646945C295B23DF95C778F24849C555FCF660670221C63DFBFEF94F6FE1A2A77B7080153CED68CCF50B785","orcidId":"0000-0002-8787-2260","documentHash":"445a3da6-1c9a-4288-bfab-a90dea99636f"},{"objectId":"5e7092bc878c28a04739bb02","name":"Yaroslav","lastName":"Zhydachevskyy","uuid":"0633A068F7FD38253CB3F882A8FF08EB32B85BC7A9CD23136DCBA0143276E37232738D042309CA209DA48C600EED010A267281C30F634EDDC2C107E1D9201AFC","orcidId":"0000-0003-4774-5977","documentHash":"ac1e28b7-49f4-497f-995a-7bc3a15ce5f4"},{"objectId":"5e7092b7878c28a04739b5e0","name":"Marek","lastName":"Berkowski","uuid":"142227C0C83958182B63DF376A3AB6EC83D9FECB2A9AD71D6698FB8DB7DD407F802841BD81CF5E24FAC836B27CE9B0861EC16BCA6B6780A7D281A1A1E9DCFAC6","orcidId":"0000-0002-1881-784X","documentHash":"679e0948-d8d4-4850-ba2e-c5cb68349feb"},{"objectId":"5e7092a5878c28a047399ea7","name":"Andrzej","lastName":"Suchocki","uuid":"B4F92D3EB438C6EE801941953070B69ACF8778481E00775A532482562A0ABAB70AD2EDFE7CD1BC23DA59D4A4615609CEBE61F4E5B5991652E2817810381B622C","orcidId":"0000-0001-7126-1951","documentHash":"f96bd335-71f8-4794-afa9-e315c30f8c78"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"JULY","releaseDateYear":2025},"objectId":"686ce01cfdbe8331796e558e","doi":"10.1038/s41598-025-05285-6","publicUri":"https://www.nature.com/articles/s41598-025-05285-6","type":"ARTICLE","typeName":"Artykuł","year":2025,"title":"New high-Z detectors based on YAlO3:Bi3+ for joint use with tissue equivalent BeO in tandem OSL dosimeter","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"The work introduces a new type of UV-emitting high-Z OSL detectors based on YAlO3:Bi3+ (YAP: Bi) perovskite. Two kinds of YAP: Bi solid state detectors have been fabricated and compared to BeO Thermalox®995 chips. The first ones are single-crystalline detectors cut from a Czochralski grown crystal. The second are detectors cut from the high-density bulk ceramics prepared by the high-pressure high-temperature (HPHT) pressing technique from nanocrystalline powder derived from sol-gel synthesis. The YAP: Bi ceramic detectors studied suffer from strong thermal fading, which makes their use impractical, at least until technological methods to modify this property of ceramics are found. The single crystalline YAP: Bi detectors show very low thermal fading, a wide linearity range of dose response and a sensitivity comparable to BeO, which together with the optical registration in the same UV range, compatible optical stimulation by blue light and similar registration times in CW-OSL mode make them ideal high-Z detectors that can be used alone or in tandem with BeO detectors."}],"affiliations":[{"id":"5fbdbeb6085dcb3958990a72","uid":"b6BkjFeIM7Ot5q0lVE0xCWg","uuid":"e228e3b7-3b6f-414f-9deb-a7b08b90f9e3","name":"Sieć Badawcza Łukasiewicz - Instytut Mikroelektroniki i Fotoniki","affiliatedPersonIDs":["5e7093fb878c28a0473b455f"],"parentId":"5fbdbeb6085dcb3958990a72","parentUuid":"e228e3b7-3b6f-414f-9deb-a7b08b90f9e3","rootId":"5fbdbeb6085dcb3958990a72","rootUuid":"e228e3b7-3b6f-414f-9deb-a7b08b90f9e3","type":"AUTHOR"},{"id":"5e70918b878c28a04737dea5","uid":"btSYdQGYDtmYBdiC2rKR_nQ","uuid":"bcec464c-f81e-4ff1-b0f0-2c9581715fe5","name":"Instytut Fizyki Polskiej Akademii Nauk","affiliatedPersonIDs":["5e7092b7878c28a04739b5e0","5e7092a5878c28a047399ea7","684cdea9ece39852c2ed33b8","67b6f108ece398373d08b7da","5e7092bc878c28a04739bb02"],"parentId":"5e70918b878c28a04737dea5","parentUuid":"bcec464c-f81e-4ff1-b0f0-2c9581715fe5","rootId":"5e70918b878c28a04737dea5","rootUuid":"bcec464c-f81e-4ff1-b0f0-2c9581715fe5","type":"AUTHOR"},{"id":"5e7091b4878c28a047385790","uid":"bIOfrRwEyd5-QD8RcZM882g","uuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","name":"Centralne Laboratorium Ochrony Radiologicznej","affiliatedPersonIDs":["5e7093f0878c28a0473b3987"],"parentId":"5e7091b4878c28a047385790","parentUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","rootId":"5e7091b4878c28a047385790","rootUuid":"b3e9cebd-01d7-43e1-8dd1-ed2b71279878","type":"AUTHOR"},{"id":"5e70918b878c28a04737deea","uid":"bwAHt3nLzTHJiUSb6EhGRLQ","uuid":"5258df8b-3924-4f7a-ab2f-6b1379e3a6dc","name":"Sieć Badawcza Łukasiewicz - Krakowski Instytut Technologiczny","affiliatedPersonIDs":["62737c357523402064564fd4"],"parentId":"5e70918b878c28a04737deea","parentUuid":"5258df8b-3924-4f7a-ab2f-6b1379e3a6dc","rootId":"5e70918b878c28a04737deea","rootUuid":"5258df8b-3924-4f7a-ab2f-6b1379e3a6dc","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"15","