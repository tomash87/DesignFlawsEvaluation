9CCCC696555BA9258DB8C71C4BCB4AD9AC9EF749DA29945881BBCBBB439A1227FD44F6D4A86CB72EDEF242A8FEE5AEDC024BACF4495BD0A4870F4B5","orcidId":"0000-0003-1762-9131","documentHash":"35a8ef1f-36a0-4082-bbf5-6e22763bd1b6"},{"objectId":"5e7092a8878c28a04739a146","name":"Marek","lastName":"Kojdecki","uuid":"E6FDDB7DD72B4B1D1590DD9F9D7CF9D6FFD16A1C6F479532AEE3F281967F00C68185E8296ADC8E0BC14C66BAD6D5A70A73ADA8B40351DCE4FD87BD4079CCE2F0","orcidId":"0000-0002-4044-0591","documentHash":"17e9470b-0984-4d5f-955b-0b6994567849"}],"objectId":"69316371fdbe834ad3d1e46f","publicUri":"https://kkm.wel.wat.edu.pl/miejsce-konferencji.html","type":"ARTICLE","typeName":"Artykuł","year":2025,"title":"MAGNETOTRANSPORT MEASUREMENTS AND MOBILITY SPECTRUM ANALYSIS IN HIGHLY CONDUCTIVE THIN FILMS","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"The analysis of mobility spectra of highly conductive thin films presents a number of difficulties related to sample preparation techniques, magnetotransport measurements, and data processing. This paper briefly discusses each of these potential, systematic errors sources and points out the main limitations of low power DC measurements. Despite these limitations,\nthe main advantages of applying mobility spectrum analysis to high conductivity layers are presented using doped indium arsenide samples as an example."}],"affiliations":[{"id":"68672793ece39852c2f28b77","uid":"bTwH_Kz2WwQPbWNHazFwfXQ","uuid":"cee92955-8bfb-4663-866a-3b5e3c2497e4","name":"Główny Urząd Miar","affiliatedPersonIDs":["69316371fdbe834ad3d1e470","69316371fdbe834ad3d1e471","5e7093f8878c28a0473b42e1"],"parentId":"68672793ece39852c2f28b77","parentUuid":"cee92955-8bfb-4663-866a-3b5e3c2497e4","rootId":"68672793ece39852c2f28b77","rootUuid":"cee92955-8bfb-4663-866a-3b5e3c2497e4","type":"AUTHOR"},{"id":"5e70918d878c28a04737e1d5","uid":"bJAF3J7gD1iEjREYkfNvHfQ","uuid":"9ab5d088-ab1d-4ba8-8cf3-3b1ed670a267","name":"Wydział Nowych Technologii i Chemii","affiliatedPersonIDs":["5e7094d6878c28a0