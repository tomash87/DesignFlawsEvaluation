e":"CC_BY_NC_ND","releaseDate":"2023-03-31","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"65016a2a4097072b3193c25d","doi":"10.22211/cejem/162891","publicUri":"http://dx.doi.org/10.22211/cejem/162891","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Analysis of Standard Methods for Determining the Properties of Explosive Materials in Ukraine","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Standardized methods for determining the basic properties of energysaturated materials in Ukraine are considered. The optimal directions for the use and development of explosives testing methodology in Ukraine are presented.\nAll of the methods considered can be applied under certain conditions, depending on the initial requirements for the test explosive."}],"affiliations":[{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e709433878c28a0473b804b"],"parentId":"5e7091b3878c28a0473856c7","parentUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","rootId":"5e7091b3878c28a0473856c7","rootUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"20","issue":"1","pagesFromTo":"75-91","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["65016a2a4097072b3193c25e","65016a2a4097072b3193c25f","5e709433878c28a0473b804b"]},"journal":{"objectId":"5e6f7d4b878c2851454775a1","mniswId":"3416","title":"Central European Journal of Energetic Materials","issn":"1733-7178","eissn":"2353-1843","websiteLink":"http://wydawnictwa .ipo.waw.pl/","documentHash":"ae20ab4f-ec96-4821-9ed3-6eaa119e8f7c"},"_version":4,"journalIssue":{"objectId":"650168c54097072b3193b8e9","year":"2023","volume":"20","number":"1","documentHash":"48615bad-efa7-4d52-b36f-42dc03264271"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["explosive, test method, thermal sensitivity, mechanical sensitivity, water-resistance, density, detonation velocity, thermodynamic properties"]}],"lastRefresh":"1761904535625"},{"authors":[{"objectId":"657e1baa4097073247680c74","name":"Wiesław","lastName":"Pucko","documentHash":"6eaedfef-7626-4b3b-8bfd-5a744f1d9e60"},{"objectId":"657e1baa4097073247680c73","name":"Maria","lastName":"Krawczyk","documentHash":"8b703a58-b2f7-4245-9ad2-965d0ffaed44"},{"objectId":"657e1baa4097073247680c72","name":"Wiesław","lastName":"Wiesław Gołębiewski","documentHash":"68f9236d-e41e-41d8-87b0-fa1912607871"},{"objectId":"657e1baa4097073247680c71","name":"Andrzej","lastName":"Maranda","documentHash":"26a26ad5-4041-4ecb-97a1-a3a7ca91dc86"},{"objectId":"5e709411878c28a0473b5b19","name":"Mirosław","lastName":"Gucma","uuid":"C4BBFC153B010E7638CD309D54630675CC1806BBC67C4A3E98ECF3DF6D3065BDE5630DA9B3ACAA2175152C5BA7BFA7D8E8AE951814A35291A3AF37D04FBD0938","documentHash":"77404a00-f741-4528-8003-8ea35b3ac972"},{"objectId":"5e70937a878c28a0473aa96d","name":"Wojciech","lastName":"SCHILF","uuid":"B84ADB6559415ACB76D4C96C33DFCE141A17232B3E502378E300C1342E9533FF7ED21AA7CDEA1FD13DA185CAB53783A69CCDA7E118B8348629176A2E8335F258","orcidId":"0000-0001-7739-7649","documentHash":"3a1d2f35-f45e-4d8d-9473-7ba92b888006"}],"objectId":"657e1baa4097073247680c70","doi":"10.15199/62.2023.5.3","publicUri":"https://sigma-not.pl/publikacja-143287-2023-5.html","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Chemiczna synteza soli amoniowych acetamiprydu, badania spektroskopowe ich równowagowych struktur izomerycznych i ich aktywności grzybobójczej","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Eight unknown acetamiprid (I) ammonium (acetamipridium) salts (hy- drochloride, sulfate, orthophosphate, formate, chloroacetate, trichlo- roacetate, methanesulfonate, and cacodilate) were synthesized by multi-stage conversion of 3-methylpyridine and studied for isomeric equil. in solns. by 2D-NMR spectroscopy and NOESY spectra to evidence the existence of 2 different isomeric structures of I (ratio 80/20). For comparison, 8 unknown analogous 3-methylpyridine salts were synthesized and identified. The X-ray anal. of growing I crystals was used to identify the geometric cis/trans isomerism of Me groups in I and to confirm its structure. The HMBC (15N-1H) NMR correlation spectra were successfully used to localize the N atoms in studied I salts where protonation took place. The fungicidal activity of the trans-I structure was also evidenced."}],"affiliations":[{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e709411878c28a0473b5b19","657e1baa4097073247680c74","657e1baa4097073247680c73","657e1baa4097073247680c72","657e1baa4097073247680c71"],"parentId":"5e7091b3878c28a0473856c7","parentUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","rootId":"5e7091b3878c28a0473856c7","rootUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","type":"AUTHOR"},{"id":"5e70918b878c28a04737dea0","uid":"bdg5X4wp8W-4e-xI_icapqQ","uuid":"8c445b8c-e3dc-4d70-b2b4-097e84208547","name":"Instytut Chemii Organicznej Polskiej Akademii Nauk","affiliatedPersonIDs":["5e70937a878c28a0473aa96d"],"parentId":"5e70918b878c28a04737dea0","parentUuid":"8c445b8c-e3dc-4d70-b2b4-097e84208547","rootId":"5e70918b878c28a04737dea0","rootUuid":"8c445b8c-e3dc-4d70-b2b4-097e84208547","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"1","issue":"5","pagesFromTo":"40-69","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["657e1baa4097073247680c71","5e70937a878c28a0473aa96d","5e709411878c28a0473b5b19","657e1baa4097073247680c72","657e1baa4097073247680c73","657e1baa4097073247680c74"]},"journal":{"objectId":"5e6f7d4f878c2851454793fd","mniswId":"16683","title":"PRZEMYSŁ CHEMICZNY","issn":"0033-2496","eissn":"0033-2496","documentHash":"60e7a787-6dab-42d2-923e-03aca9974526"},"_version":4,"journalIssue":{"objectId":"6475e31f409707169e4d4915","year":"2023","volume":"1","number":"5","documentHash":"4760499f-7f85-44b3-8cea-90771341d173"},"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761904656207"},{"authors":[{"objectId":"5e709450878c28a0473ba51a","name":"Jacek","lastName":"Grodner","uuid":"13FB5B92BD656E29B4E1F69AA46AE465FEB594061389CE99C2FC9D2B0E1CE95B931044F726FA984CCEF074FB415840E84F23234BA5FA49AB4F1DA2C7B8CDE32C","orcidId":"0000-0003-3218-453X","documentHash":"62ebe3d6-0c5b-4c03-bd6f-01342c46ea0b"}],"objectId":"6641ddef40970755576e2d0f","doi":"10.1055/s-0042-1751573","publicUri":"http://www.thieme-connect.de/products/ejournals/pdf/10.1055/s-0042-1751573.pdf","type":"ARTICLE","typeName":"Artykuł","year":2024,"title":"Stereoselective Reduction of Conjugated and Non-conjugated Triple Bonds in Attractant Precursors with Zn Activated by Cu: A Designed Approach to the Synthesis of Conjugated Dienic Pheromones","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"A simple, highly stereoselective, and efficient method to obtain important attractants by the reduction of the triple bond in several E-enynes and hex-3-ynyl acetate by an activated Zn-Cu system is described. The stereoselectivity of the semireduction for the generation of a new (Z)-C=C bond was >98%. The substrates for the reduction reaction were obtained by new synthetic routes with an overall yield of more than 40%."}],"affiliations":[{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e709450878c28a0473ba51a"],"parentId":"5e7091b3878c28a0473856c