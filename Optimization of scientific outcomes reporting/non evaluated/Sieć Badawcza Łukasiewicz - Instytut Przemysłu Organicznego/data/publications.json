ionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"pol","keywords":["stałe heterogeniczne paliwa rakietowe, pył glinu, mechanizm spalania glinu, przegląd literaturowy"]},{"languageCode":"eng","keywords":["solid heterogeneous rocket propellants, aluminum powder, mechanism of aluminum combustion,  literature review"]}],"lastRefresh":"1761904372519"},{"authors":[{"objectId":"5e709390878c28a0473ace97","name":"Rafał","lastName":"Lewczuk","uuid":"51FFE522EACF8574EDA96C64EF0EA0FF58A54924576ACFF32AAD43B1BC67A03E8AB05E4B6C7222F48B500E8A7B507FB5F7FE27A84512FE31E5F4A67463F21D51","orcidId":"0000-0003-1120-7958","documentHash":"235db93d-d302-4dc9-9c12-63688e5a224f"},{"objectId":"5e70938b878c28a0473ac6d8","name":"Katarzyna","lastName":"Gańczyk-Specjalska","uuid":"9C5DB353BF462899AF4B574DD0EF950FCF59F42F70E02A02F841F4722C70320C6E3BB22FD2C924EF5C567831AB635B78A608B57261A1DBEFD293A8021AE2FCEE","orcidId":"0000-0002-8394-1513","documentHash":"82e99435-2ead-45b5-801f-25b7bc490935"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_NC_ND","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"SEPTEMBER","releaseDateYear":2022},"objectId":"63fc7f6a4097074e59fb3bfd","doi":"10.22211/cejem/154982","publicUri":"http://dx.doi.org/10.22211/cejem/154982","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Modern Highly Energetic Materials for the Production of Gun Powders and Rocket Propellants in Poland","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Polish technology for the production of propellants uses methods\nwhich have been known for many years. The continuously developing market\nrequires producers to enhance the parameters of their munitions in order to keep\nup with demands. Therefore, it is necessary to research and constantly implement\nnew types of gun powders and rocket propellants. In the present work, highly\nenergetic compounds were characterized as constituents of current propellants.\nTheir advantages and disadvantages are described. The requirements for new\nmaterials, concerning toxicity, environmental impact, and safety are presented.\nIt is shown that by using modern energetic compounds it is possible to obtain\nlow-vulnerability or insensitive ammunitions. Finally, the situation in the Polish\nmarket is briefly described"}],"affiliations":[{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e709390878c28a0473ace97","5e70938b878c28a0473ac6d8"],"parentId":"5e7091b3878c28a0473856c7","parentUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","rootId":"5e7091b3878c28a0473856c7","rootUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"19","issue":"3","pagesFromTo":"281-294","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709390878c28a0473ace97","5e70938b878c28a0473ac6d8"]},"journal":{"objectId":"5e6f7d4b878c2851454775a1","mniswId":"3416","title":"Central European Journal of Energetic Materials","issn":"1733-7178","metadataSource":"IMPORT","documentHash":"f8b95fed-a03c-4e4f-baa5-1d526f6f7733"},"_version":4,"journalIssue":{"objectId":"63fc7f6a4097074e59fb3bfe","year":"2022","volume":"19","number":"3","documentHash":"5c8f320c-80e1-43ef-854b-51dbc83d49ea"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["gun powders","rocket propellants","highly energetic materials"]}],"lastRefresh":"1761904390734"},{"authors":[{"objectId":"5e709411878c28a0473b5b19","name":"Mirosław","lastName":"Gucma","uuid":"C4BBFC153B010E7638CD309D54630675CC1806BBC67C4A3E98ECF3DF6D3065BDE5630DA9B3ACAA2175152C5BA7BFA7D8E8AE951814A35291A3AF37D04FBD0938","documentHash":"77404a00-f741-4528-8003-8ea35b3ac972"},{"object