[{"authors":[{"objectId":"5e7094c5878c28a0473c36c8","name":"Anna","lastName":"Daniel-Wójcik","uuid":"766BFE5471C69A5C97E6FC1257E1D725C828A6BC8732955257B880869AE24AC9AC18E739654B70FC48A9A03303BC343ACB955D346DDCB995301A7DC836069341","orcidId":"0000-0002-8983-6634","documentHash":"5e8ed460-3022-4fb3-b056-83fa4f2727b4"},{"objectId":"5e709499878c28a0473c0272","name":"Dominika","lastName":"Gądarowska","uuid":"538842CC33899DE9A430908B12F1A08DB8AEB01FF8CA665451823B6BD051F34FA6BBCC42ECF382B321B213F41D8729A4D2994A5407956352CA827A9D36BC47E9","orcidId":"0000-0002-8568-5525","documentHash":"25e14b7a-78cb-4c7e-95b7-7340c929aaf0"},{"objectId":"5e709450878c28a0473ba5a5","name":"Daniel","lastName":"Krakowian","uuid":"85B141D18FD24E36FF5B9C94EAC393FEADFA129E3173C4C91DBD3AEEB6D1CA57E202636E320D62BED88BB838F541D42C30DBF3DC9FF5ED4B2B58545D6284FC2A","orcidId":"0000-0002-6647-6138","documentHash":"4957481f-2703-4237-96cb-21c3e7502f78"},{"objectId":"5e7093b9878c28a0473afd7a","name":"Inga","lastName":"Mrzyk","uuid":"C94D734D78B0AD5AEA10F986EF23F13C3FF673F32927031A0FF86B61585DFD1A84E81964A955C81B619F25A2538DC1F53C8B880F6B0646528E037CE65429C172","orcidId":"0000-0002-2141-1381","documentHash":"b70c2f0f-a427-4d2e-b075-6434ae592fc8"}],"objectId":"6238823a2467f067af12e276","doi":"10.1016/j.tiv.2022.105343","publicUri":"https://api.elsevier.com/content/article/PII:S0887233322000406?httpAccept=text/xml","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Cytotoxicity assay to assess eye irritation – A comparison with other methods and possible strategies for use","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Many in vitro methods can be used to classify eye irritation or damage caused by exposure to a substance. In this\nstudy, a recently described method called the Cytotoxicity Assay to Assess Eye Irritation (CEI) was compared\nwith other selected in vitro methods adopted in the OECD guidelines. Furthermore, the influence of combining\nmore than one in vitro method was investigated. Basic performance indices were considered and a risk assessment\nbased on the number of correct and incorrect results (overestimated or underestimated) was performed. The CEI\nresults were similar to those of other in vitro tests, however, the CEI can also directly classify substances irritating\nto the eyes. When the CEI preceded an eye irritation test based reconstructed human corneal-like epithelium,\nthere were fewer underestimates compared with other method combinations. This combination can better\nprotect human health and provides results comparable to those obtained in animal tests."}],"affiliations":[{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e7093b9878c28a0473afd7a","5e709499878c28a0473c0272","5e709450878c28a0473ba5a5","5e7094c5878c28a0473c36c8"],"parentId":"5e7091b3878c28a0473856c7","parentUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","rootId":"5e7091b3878c28a0473856c7","rootUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"81","pagesFromTo":"105343","articleEvaluation":{"isReview":true},"contributionOrder":{"AUTHOR":["5e709450878c28a0473ba5a5","5e709499878c28a0473c0272","5e7094c5878c28a0473c36c8","5e7093b9878c28a0473afd7a"]},"journal":{"objectId":"5e6f7d50878c285145479971","mniswId":"19608","title":"Toxicology in Vitro","issn":"0887-2333","documentHash":"6c994f54-c837-40fc-9787-a8fb29593039"},"_version":4,"journalIssue":{"objectId":"6238823a2467f067af12e27c","year":"2022","volume":"81","documentHash":"d95f37c2-873c-44ab-9b50-b53b38b850c5"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[],"lastRefresh":"1761904203543"},{"authors":[{"objectId":"5e709433878c28a0473b804b","name":"Tomasz","lastName":"Sałaciński","uuid":"E0659BFB5B6928946221C40CB4548A16A5852DAE7E60B129627AC83FD4D4C0079C82D2C7C1D58E23D233205BA7625408BEF672D000BE845D9E51A8D38F989F3C","orcidId":"0000-0002-4376-4081","documentHash":"cd48bbf5-4447-49c7-8cbe-8ddf4fde6e95"},{"objectId":"5e709282878c28a04739704b","name":"Iwona","lastName":"Zawadzka-Małota","uuid":"B66CAC83C9269D563A3F1A9FF536446698DDBB6CF5CD1DD48EC83504DD02C72E77AFB2C87AA3DC215E966302022F1FE90315A38643038A44851139FBC8A4BD0D","orcidId":"0000-0002-3290-0068","documentHash":"db9fa3bb-6d42-4c33-ace3-1993107a7578"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY_NC_ND","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateMonth":"JULY","releaseDateYear":2022},"objectId":"62e247854097077d65a9f898","doi":"10.22211/cejem/151774","publicUri":"https://ipo.lukasiewicz.gov.pl/wydawnictwa/cejem-woluminy/vol-19-nr-2/","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Some Remarks on the Safety of Methane Penthrite Detonating Cords against the Inflammability of a Methane-Air Mixture","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"After analysing literature data some topics related to the properties and testing methods of detonating cords (DCs) are presented. The main attention is paid to the 2,2-bis[(nitrooxy)methyl]propane-1,3-diyl dinitrate (penthrite, PETN)-based DCs. In a case study of methane PETN DC, it is shown that the problem of DCs being able to fulfil safety precautions as permitted explosives is very complex, i.e. to determine their ability to ignite a methane-air atmosphere in coal mines. The tests have shown that the relationships between safety and the performance properties of methane PETN DC are not obvious. For example, an increase in the outer thickness coating of this methane PETN DC, causes the inflammability of a methane-air mixture to be decreased. Moreover, an increase in the amount of crystalline PETN in the cord’s core caused an increase in its velocity of detonation, but had no impact on its ability to ignite a methane-air mixture in the experimental gallery."}],"affiliations":[{"id":"5e70918b878c28a04737decd","uid":"bDVT6eE951oVevqx9vwsANA","uuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","name":"Główny Instytut Górnictwa - Państwowy Instytut Badawczy","affiliatedPersonIDs":["5e709282878c28a04739704b"],"parentId":"5e70918b878c28a04737decd","parentUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","rootId":"5e70918b878c28a04737decd","rootUuid":"52307719-d5a8-4e16-8c65-acc1f011e9bb","type":"AUTHOR"},{"id":"5e7091b3878c28a0473856c7","uid":"bqrU71fxUg9VHXvsCrbCYGA","uuid":"041beb1d-3c82-4347-bd70-387c501c8f46","name":"Sieć Badawcza Łukasiewicz - Instytut Przemysłu Organicznego","affiliatedPersonIDs":["5e709433878c28a0473b804b"],"parentId":"5e7091b3878c28a0473856c7","parentUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","rootId":"5e7091b3878c28a0473856c7","rootUuid":"041beb1d-3c82-4347-bd70-387c501c8f46","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"19","issue":"2","pagesFromTo":"181-203","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709282878c28a04739704b","5e709433878c28a0473b804b"]},"journal":{"objectId":"5e6f7d4b878c2851454775a1","mniswId":"3416","title":"Central European Journal of Energetic Materials","issn":"1733-7178","metadataSource":"IMPORT","documentHash":"f8b95fed-a03c-4e4f-baa5-1d526f6f7733"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["detonating cord","2,2-bis[(nitrooxy)methyl]propane-1,3-diyl dinitrate","penthrite","PETN","safety","methane-air mixture","inflammability","blasting work"]}],"lastRefresh":"1761904247924"},{"authors":[{"objectId":"63d8f39a40970739949080c9","name":"Paulina","lastName":"Paziewska","documentHash":"991eed37-2113-4742-9e49-e74dbfce0856"},{"objectId":"5e70938b878c28a0473ac6d8","name":"Katarzyna","lastName":"Gańczyk-Specjalska","uuid":"9C5DB353B