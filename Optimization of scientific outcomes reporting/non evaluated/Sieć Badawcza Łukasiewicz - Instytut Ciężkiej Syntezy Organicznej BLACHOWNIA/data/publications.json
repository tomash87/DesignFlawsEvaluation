[{"authors":[{"objectId":"620f8a9a2467f0419c5a67ea","name":"Artur","lastName":"Porada","documentHash":"9ee6ba98-d503-49f2-b170-e34d5c26e5f6"},{"objectId":"620f8a9a2467f0419c5a67e7","name":"Rafał","lastName":"Matejuk","documentHash":"df2c1570-8480-474f-aa07-5f64c02cb43f"},{"objectId":"620f8a9a2467f0419c5a67e6","name":"Renata","lastName":"Kulesza","documentHash":"967c6e07-64c2-468e-ba84-a8da5683ff6f"},{"objectId":"620f8a992467f0419c5a67e5","name":"Anna","lastName":"Jaszkiewicz","documentHash":"1ea8bd1f-4228-4155-b08a-5938dead7506"},{"objectId":"620f8a992467f0419c5a67e4","name":"Krzysztof","lastName":"Barabosz","documentHash":"c16b1f94-11ec-429d-b4d6-9eedea082d57"},{"objectId":"620f8a992467f0419c5a67e3","name":"Natalia","lastName":"Stanek","documentHash":"2b918f58-867d-40ec-8aa3-e9a7296245ff"},{"objectId":"620f8a992467f0419c5a67e2","name":"Magdalena","lastName":"Zarebska","documentHash":"f6f11171-8538-4abf-9b4a-ae92621587e8"},{"objectId":"5e7093bd878c28a0473aff4c","name":"ŁUKASZ","lastName":"BIŁOS","uuid":"250ECFA8A911872531BBE7B595C3E3DFD77936322BFD680CCD8E2748C841DF3313D5B2ACC89005A9927CECC874AC5C2B5839CEAF6F98EAE791C2860A3AF6499F","documentHash":"73e86e4f-eb55-4da4-b07a-660573e6bbf7"},{"objectId":"5e7093b2878c28a0473af5f4","name":"DARIUSZ","lastName":"ANDRZEJEWSKI","uuid":"1BAFF703960C2BCFF5BED937456E9E163107CDB0E6376FF1B9E7D648E7A0BCF8B3C38C0D8C9D7431C3557A64748916884E0FFD6D36FC92613B87B4691A55EA92","documentHash":"93135a2d-72ac-4193-aca2-4397f0b61725"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"CC_BY","releaseDate":"2022-02-17","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL","releaseDateYear":2022},"objectId":"620f8a992467f0419c5a67e0","doi":"10.1038/s41598-022-06676-9","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Comparison of chemical compounds and their influence on the taste of coffee depending on green beans storage conditions","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Currently, there is no technology for the storage of green coffee (GrC), that results in obtaining high-quality roasted coffee (RC). The aim of this study was to evaluate the effects of storage temperature (− 10, 5, 10, 18, 20 °C), postharvest treatment method (natural (N), washed (W)) and type of packaging material (GrainPro (G), jute (J) bags) on the content of chlorogenic acids (CQAs), caffeine and trigonelline as well as the sensory profile of RC from the specialty sector after 12 months of regulated storage. Sensory analysis showed that natural coffees have better taste and higher quality than washed coffees after 12 months of storage. The highest total scores were obtained from the natural coffee stored in a GrainPro bag at − 10 °C followed by coffee stored in a jute bag at 10 °C which had the smallest decreases compared to the initial recorded values. No notable differences among CQA contents in washed coffees stored in either type of bag was seen but natural coffees stored in jute bags at 10 °C and 18 °C displayed the lowest drops relative to the initial values."}],"affiliations":[{"id":"5e7091b3878c28a047385704","uid":"b5nOr06xLd1QOKg4ZZoMmZg","uuid":"bae7be6a-8b71-4488-a60f-cf37c0bf27f1","name":"Sieć Badawcza Łukasiewicz - Instytut Ciężkiej Syntezy Organicznej BLACHOWNIA","affiliatedPersonIDs":["620f8a992467f0419c5a67e5","620f8a9a2467f0419c5a67e6","620f8a992467f0419c5a67e2","620f8a992467f0419c5a67e3"],"parentId":"5e7091b3878c28a047385704","parentUuid":"bae7be6a-8b71-4488-a60f-cf37c0bf27f1","rootId":"5e7091b3878c28a047385704","rootUuid":"bae7be6a-8b71-4488-a60f-cf37c0bf27f1","type":"AUTHOR"},{"id":"5e70918b878c28a04737de30","uid":"bQp8ITDzg_V-1GFpvOVvvtg","uuid":"8c8aabb6-fc72-4e4e-bb15-218703aa9f43","name":"Politechnika Opolska","affiliatedPersonIDs":["5e7093b2878c28a0473af5f4","5e7093bd878c28a0473aff4c"],"parentId":"5e70918b878c28a04737de30","parentUuid":"8c8aabb6-fc72-4e4e-bb15-218703aa9f43","rootId":"5e70918b878c28a04737de30","rootUuid":"8c8aabb6-fc72-4e4e-bb15-218703aa9f43","type":"A