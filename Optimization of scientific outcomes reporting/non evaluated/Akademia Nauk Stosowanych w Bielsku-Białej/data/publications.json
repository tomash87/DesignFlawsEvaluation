35f"],"parentId":"5e70918a878c28a04737dcf6","parentUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","rootId":"5e70918a878c28a04737dcf6","rootUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"15","issue":"10","pagesFromTo":"3646","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["62895ffc40970757d821246b","62895ffc40970757d821246c","62895ffc40970757d821246d","62895ffc40970757d821246e","62895ffc40970757d821246f","62895ffc40970757d8212470","62895ffc40970757d8212471","5e70936c878c28a0473a935f"]},"journal":{"objectId":"5e6f7d4b878c285145477aa9","mniswId":"5673","title":"Energies","doi":"10.3390/en","issn":"1996-1073","eissn":"1996-1073","documentHash":"073c6b4f-b994-4710-8065-02d74e1e73ce"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761904221991"},{"authors":[{"objectId":"5ebee56b752340254fc449bd","name":"Dariusz","lastName":"Szydłowski","uuid":"4F913AD02D39B8274AEA66EC28D64DE7FA12825B11ABA517B89307C79A09DE82B3B94FD7190D42C0B159590100728C1BA74787E8D41B31B8EB51C339278D36DE","orcidId":"0000-0003-0353-1141","documentHash":"0718abeb-f3db-4a91-8f36-991e2d317faf"},{"objectId":"5ebed7d2752340254fc40d06","name":"Marek","lastName":"Gołuch","uuid":"64E11B014A4A44FDE1BEFF335EA52F447F608149FBDC2D0B20AAC17F47148D51061B4C23C70AF8BD6B6B60B181FC73D6A7D9A3117BF83D8DC47B37B704A238D9","documentHash":"96b26df9-2baf-463a-b48e-f7558729e308"}],"objectId":"63b7e3714097077b6be8e8fc","publicUri":"https://www.researchgate.net/publication/364351694","type":"CHAPTER","typeName":"Rozdział","year":2022,"title":"Identyfikacja mechanoskopijna śladów fałszowania oznaczeń pojazdów przy użyciu defektoskopu stałomagnetycznego","otherTitles":[],"abstracts":[{"languageCode":"pol","content":"Wykorzystywanie śladów kryminalistycznych jest ważnym elementem procesu\ndowodowego w postępowaniu przygotowawczym, mającym na celu\nidentyfikację osoby lub rzeczy, od której dany ślad pochodzi. Może gwarantować\nefektywność w realizacji zadań dochodzeniowo-śledczych oraz skuteczność\ndziałań profilaktycznych w sytuacjach naruszenia porządku i bezpieczeństwa\npublicznego. Badanie śladów mechanoskopijnych to w obecnych\nczasach domena wyspecjalizowanego działu techniki kryminalistycznej. Ich\nistotą jest ustalenie oddziaływań narzędzi z przedmiotem na podstawie cech\npozostawionych przez nie śladów.\nWyniki badań mechanoskopijnych odgrywają istotną rolę w procesie\ndowodowym i wykrywczym. Pozwalają na wykazanie powiązania podejrzanego\nlub narzędzia z konkretnym zdarzeniem, będącym przedmiotem po\nstępowania przygotowawczego. Mechanoskopijne badania śladów kryminalistycznych\nto także czynności związane z oceną autentyczności numerów\nidentyfikacyjnych samochodów. Pozwalają one między innymi na ustalenie,\nczy będący przedmiotem ekspertyzy samochód był kradziony. Wykonywane\nw ich toku czynności dają niejednokrotnie efekt końcowy potwierdzający\nfakt przerobienia oznaczeń identyfikacyjnych pojazdu. Charakterystyka\ntych badań wiąże się często z użyciem specjalistycznego sprzętu oraz z zastosowaniem\nspecyficznych form badawczych. Nie oznacza to, że badania\nmechanoskopijne opierają się wyłącznie na takich metodach, ponieważ w ich\ntoku stosowane są również metody i urządzenia zaczerpnięte z innych dziedzin\ntechniki."}],"affiliations":[{"id":"5e70918a878c28a04737dcf6","uid":"bCmrawuadrrvaf3xpK4mHFA","uuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","name":"Akademia Nauk Stosowanych w Bielsku-Białej","affiliatedPersonIDs":["5ebee56b752340254fc449bd","5ebed7d2752340254fc40d06"],"parentId":"5e70918a878c28a04737dcf6","parentUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","rootId":"5e70918a878c28a04737dcf6","rootUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","pagesFromTo":"381-407","contributionOrder"