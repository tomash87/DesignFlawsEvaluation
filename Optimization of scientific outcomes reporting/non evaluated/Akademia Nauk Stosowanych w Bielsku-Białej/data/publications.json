1X","metadataSource":"MINISTRY","documentHash":"b805b6d7-bacf-486c-8eb3-3654f6a45c6a"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761905430027"},{"authors":[{"objectId":"5e709463878c28a0473bc0a4","name":"Jolanta","lastName":"Pochopień","uuid":"0817A6B3B21EDEDEAFF9F8ACD51E4B43D5E55CE653D6B44EE266F59E3A86A40AB4CE9DC712A4847E12C73247F48ED8D14A08D553061D9F3D70CDA3BC4A46D570","documentHash":"17319cb6-02c7-48c2-a410-20046a1d97d8"}],"objectId":"68910596fdbe831f2480c243","publicUri":"https://asej.eu/index.php/asej/article/view/680","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Potential for implementation of the development of integration concepts economics and ecology in the economic activity of social systems","otherTitles":[],"abstracts":[],"affiliations":[{"id":"5e70918a878c28a04737dcf6","uid":"bCmrawuadrrvaf3xpK4mHFA","uuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","name":"Akademia Nauk Stosowanych w Bielsku-Białej","affiliatedPersonIDs":["5e709463878c28a0473bc0a4"],"parentId":"5e70918a878c28a04737dcf6","parentUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","rootId":"5e70918a878c28a04737dcf6","rootUuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","volume":"26","issue":"4","articleEvaluation":{"indexedJournal":false,"isReview":false,"wosConference":false},"contributionOrder":{"AUTHOR":["5e709463878c28a0473bc0a4"]},"journal":{"objectId":"61b9abddad204581b62eba51","mniswId":"201342","title":"Scientific Journal of Bielsko-Biala School of Finance and Law","issn":"2543-9103","eissn":"2543-411X","metadataSource":"MINISTRY","documentHash":"b805b6d7-bacf-486c-8eb3-3654f6a45c6a"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761905431129"},{"authors":[{"objectId":"5e70936c878c28a0473a935f","name":"Aleksander","lastName":"Sapiński","uuid":"8C625109600BF67024510B1382DABEF2E0C09080C26C23E23E81D7446E1EA1C081BD5C2B3B559B3DDA7B83E2410D919637FF49C2B282F716A067AF34E611F483","orcidId":"0000-0002-3326-2387","documentHash":"0d7973c5-2a31-42d6-bf6b-ae8b030fca24"}],"objectId":"689106cafdbe831f2480c2fd","doi":"10.32038/mbr.2022.09.01.04","publicUri":"https://eurokd.com/doi/10.32038/mbr.2022.09.01.04","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"The Role of Marketing in Creating and Sustaining Poland's National Brand","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"National branding, which is used by strategic marketing for a country's identity, has become a strategic tool for a country's competitiveness. Nevertheless, only a few countries in Europe have developed and implemented branding strategies. Poland belongs to such countries that are only formulating and developing branding strategies. Accordingly, there is a need to formulate recommendations for the development of the national brand using modern marketing technologies and tools. Therefore, the purpose of the study is to clarify the directions of the development of the national brand and branding, as well as to develop directions for the use of modern marketing tools for the development of the national brand. In conducting the research, the author used general scientific and special methods: analysis and synthesis, induction and deduction, systematisation and grouping, and a systematic approach. In the process of developing the research topic, it was proved that national branding increases exports, stimulates foreign investment and tourism. For Poland, it is important to introduce a comprehensive national branding system, which will allow to obtain positive results in various spheres of public life."}],"affiliations":[{"id":"5e70918a878c28a04737dcf6","uid":"bCmrawuadrrvaf3xpK4mHFA","uuid":"e2ac2314-9c03-4226-a5e2-a3739b3b76a8","name":"Akademia Nauk Stosowanych w Bielsku-Białej","affiliatedPersonIDs":["5