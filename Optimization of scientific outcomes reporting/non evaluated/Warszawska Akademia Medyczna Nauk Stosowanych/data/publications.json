[{"authors":[{"objectId":"65a0fd094097071121a24e43","name":"Mateusz","lastName":"Zajączkowski","documentHash":"6ea55d6c-81fa-400d-913f-2f6e9e53b91b"},{"objectId":"5e709437878c28a0473b842c","name":"Jarosław","lastName":"Pasek","uuid":"3ECA1F1C7050F50EAE798AF7C2FA396D9B78FAF70F6EC91DFFABF36BDA0D1975530CA604588CB9D0ECD6F7215CAD1661FC1356B9B698F1752DD3BC4B05DC4171","orcidId":"0000-0001-6181-337X","documentHash":"d01cb9d2-ecef-46d9-a054-36b7d68256c1"},{"objectId":"5e7093c5878c28a0473b0737","name":"SEBASTIAN","lastName":"SZAJKOWSKI","uuid":"0DAA4D6E4EE05C6E3DA69FEF05C76AD5A90B0FB887560933A27E7E48FF1E961CBA2E90A130B30949D442CFD0334FE12C7C9B7EAE0A817FBB8CBA354B94C08DB1","orcidId":"0000-0003-4983-8018","documentHash":"9fe81649-4a96-4c8a-aecf-6e4798564322"},{"objectId":"5e70933a878c28a0473a5546","name":"Michał","lastName":"Dwornik","uuid":"F6363610633747F639F2FA2D381655414E3A45ADDE238D7E7753DB3AB132C0A3DFCF859167B79243189A1B15157AEDBC197F949CA7179603D9C34F82312DAD0B","orcidId":"0000-0002-0528-8854","documentHash":"b89eff73-a97e-4808-b598-f9d412a8f015"},{"objectId":"5e709262878c28a047394cb2","name":"Grzegorz","lastName":"Cieślar","uuid":"F4FFF39BD6CD250BFE78B7ACCCE01007AD09632B02C5B721250F5948607C7E9D99F463C0F4F7FC378E67C88AC50B50010A540FA017EA244C5DC299290A90B458","orcidId":"0000-0003-2210-8744","documentHash":"6de93ad6-319f-409f-8217-99ffd40c8453"}],"openAccess":{"textVersion":"FINAL_PUBLISHED","license":"OTHER","releaseDate":"2023-07-13","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"65a0fd094097071121a24e42","doi":"10.37190/abb-02283-2023-01","publicUri":"https://www.actabio.pwr.wroc.pl/Vol25No2/31.pdf","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Are the mechanical properties of Achilles tendon altered in CrossFit athletes? Reliability and accuracy of myotonometry","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Purpose: Tendons adapt to loads affecting them by changing tendons’ mechanical and morphological properties. The aim of the study was to investigate the influence of involvement in sport activities in the form of CrossFit training by individuals of different age upon the mechanical properties of Achilles tendon. Methods: 231 people participated in the study. One group consisted of subjects who trained CrossFit as amateurs, the other group comprised subjects who were not physically active. Achilles tendon was studied for various positions of the ankle joint: 0° DF/PF, 10° DF, 20° DF, 20° PF and 40° PF. The following mechanical and viscoelastic tendon properties were measured using MyotonPRO: frequency [Hz], stiffness [N/m], decrement [log], relaxation time [ms] and creep [De]. The results have been compared in reference to physical activity, BMI, age and length of training history. Results: Both the tension and stiffness increased with degree of Achilles tendon stretching and decreased as it contracted. Higher values have been noted in the group of people in training and with higher BMI values. The elasticity of Achilles tendon decreased with plantar flexion increase. Lower elasticity has been recorded in the group in training and with higher BMI. No significant influence of age and length of training history upon the parameters achieved has been noted. Conclusions: The specificity of CrossFit training and accompanying mechanical load result in development of adaptation changes in Achilles tendon, in the form of its higher tone/tension and stiffness, as well as lower elasticity."}],"affiliations":[{"id":"5e70918b878c28a04737de50","uid":"byQikIwqf13QiA2ApyMoNIQ","uuid":"cd474cbb-d4ba-4475-b0d0-580f5f2e17ef","name":"Śląski Uniwersytet Medyczny w Katowicach","affiliatedPersonIDs":["5e709262878c28a047394cb2"],"parentId":"5e70918b878c28a04737de50","parentUuid":"cd474cbb-d4ba-4475-b0d0-580f5f2e17ef","rootId":"5e70918b878c28a04737de50","rootUuid":"cd474cbb-d4ba-4475-b0d0-580f5f2e17ef","type":"AUTHOR"},{"id":"5e70918a878c28a04737dcff","uid":"bBSGPZSzFKWv2qJD7SsanIw","uuid":"0878762b