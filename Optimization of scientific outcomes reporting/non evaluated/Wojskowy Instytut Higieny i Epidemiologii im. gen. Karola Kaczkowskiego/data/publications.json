-4175-42a0-8256-0038ac0779c8"},"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["electrochemical biosensor","Bacillus anthracis spore detection","microbiological analysis","portable sensor","immunoelectrochemical detection"]}],"lastRefresh":"1761905515188"},{"authors":[{"objectId":"658d73b54097076c145844f7","name":"Jarosław","lastName":"Grobelny","documentHash":"90756efd-e3ca-47ed-9687-94068c273c58"},{"objectId":"658d73b54097076c145844f6","name":"Grzegorz","lastName":"Celichowski","documentHash":"0ba63a1c-9460-44e5-8b8a-e2a816ed78e3"},{"objectId":"658d73b54097076c145844f5","name":"Katarzyna","lastName":"Ranoszek-Soliwoda","documentHash":"83ac46bc-c9c8-44ba-bfb7-b15f44732704"},{"objectId":"658d73b54097076c145844f4","name":"Emilia","lastName":"Tomaszewska","documentHash":"3b2a88d1-9ce3-4ef2-905e-999ab235944b"},{"objectId":"658d73b54097076c145844f3","name":"Martyna","lastName":"Janicka","documentHash":"bcbd4b33-0623-438a-99c3-19da5805b71e"},{"objectId":"5e7092de878c28a04739e79e","name":"Paweł ","lastName":"SZYMAŃSKI","uuid":"CA45969ED11EA297A5AC98573887E340B3F557EA18E222A2044C26F23B853A2229856D17A39721B1408AEEB1053F504EBEDFADB1656991C202702CFA04F2A697","orcidId":"0000-0003-3438-7509","documentHash":"67cf5b5c-6691-422a-b7ab-dfe1c925db95"},{"objectId":"5e70923a878c28a047392103","name":"Małgorzata","lastName":"Krzyżowska","uuid":"D6138E0BBBCE270D3DB499158BA38501565F5A70552D599A5FF4115B3283A0AACFE42157250DE26C4D690DE8AC4A96E443FC03DC07E5C9CB1498374AF158BF91","orcidId":"0000-0002-8409-3974","documentHash":"910d6134-ba04-4b8e-9e88-971c77424b30"}],"objectId":"65671ac140970749a84437a9","doi":"10.3390/pharmaceutics14091862","publicUri":"https://www.mdpi.com/1999-4923/14/9/1862","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Lactoferrin - Conjugated Nanoparticles as New Antivirals","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"Lactoferrin is an iron-binding glycoprotein with multiple functions in the body. Its activity against a broad spectrum of both DNA and RNA viruses as well as the ability to modulate immune responses have made it of interest in the pharmaceutical and food industries. The mechanisms of its antiviral activity include direct binding to the viruses or its receptors or the upregulation of antiviral responses by the immune system. Recently, much effort has been devoted to the use of nanotechnology in the development of new antivirals. In this review, we focus on describing the antiviral mechanisms of lactoferrin and the possible use of nanotechnology to construct safe and effective new antiviral drugs.\r\n"}],"affiliations":[{"id":"5e70918b878c28a04737df01","uid":"b9Kh7wVIXJf5RFdoScAr8ag","uuid":"25fa4f1b-b4e7-430f-9d9b-6d0c24ccd9c8","name":"Wojskowy Instytut Higieny i Epidemiologii im. gen. Karola Kaczkowskiego","affiliatedPersonIDs":["5e70923a878c28a047392103","658d73b54097076c145844f3"],"parentId":"5e70918b878c28a04737df01","parentUuid":"25fa4f1b-b4e7-430f-9d9b-6d0c24ccd9c8","rootId":"5e70918b878c28a04737df01","rootUuid":"25fa4f1b-b4e7-430f-9d9b-6d0c24ccd9c8","type":"AUTHOR"},{"id":"5e709196878c28a04737f7f5","uid":"bqGum1YCSBNmPv-Jux8WOww","uuid":"f8ebdfc2-10a5-48d6-b469-a22c54e74f92","name":"Instytut Medycyny Weterynaryjnej","affiliatedPersonIDs":["658d73b54097076c145844f3"],"parentId":"5e70918b878c28a04737de36","parentUuid":"40ee9e13-51b8-4fde-b8b0-e9fb7505c3b9","rootId":"5e70918b878c28a04737de36","rootUuid":"40ee9e13-51b8-4fde-b8b0-e9fb7505c3b9","type":"AUTHOR"},{"id":"5e70918a878c28a04737de19","uid":"bao42pugiv9thUK7yYPpTDg","uuid":"5011bcd5-dfb1-41ed-84b0-5bd51ce0832c","name":"Uniwersytet Łódzki","affiliatedPersonIDs":["658d73b54097076c145844f7","658d73b54097076c145844f6","658d73b54097076c145844f5","658d73b54097076c145844f4"],"parentId":"5e70918a878c28a04737de19","parentUuid":"5011bcd5-dfb1-41ed-84b0-5bd51ce0832c","rootId":"5e70918a878c28a04737de19","rootUuid":"5011bcd5-dfb1-41ed-84b0-5bd51ce