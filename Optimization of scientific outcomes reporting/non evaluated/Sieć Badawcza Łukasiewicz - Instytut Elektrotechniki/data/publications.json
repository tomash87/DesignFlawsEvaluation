":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761904370682"},{"authors":[{"objectId":"5e70943c878c28a0473b88d8","name":"Józef","lastName":"Dąbrowski","uuid":"C179DFD104F292BB3A92D1CF7FC2E4D9897B709219484D43F866FD67063B4740FEBEA913B1200F2CB6D35CA276BA482250804C84420E87F75596DFE86F4A3C3C","documentHash":"4b370d07-48e3-4a0e-8d01-8978d85b488a"}],"objectId":"63d7aff04097074c742a3fe6","publicUri":"https://igkm.pl/biuletyn-komunikacji-miejskiej-nr-163-luty-2022/","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Czy liczniki energii elektrycznej w pojazdach sieci tramwajowej są niezbędne?","otherTitles":[],"abstracts":[],"affiliations":[{"id":"5e70918b878c28a04737ded5","uid":"b1XGvJiw-TsKhXZq-S51_4g","uuid":"10104d5b-8342-476d-a50f-e84ec4c04676","name":"Sieć Badawcza Łukasiewicz - Instytut Elektrotechniki","affiliatedPersonIDs":["5e70943c878c28a0473b88d8"],"parentId":"5e70918b878c28a04737ded5","parentUuid":"10104d5b-8342-476d-a50f-e84ec4c04676","rootId":"5e70918b878c28a04737ded5","rootUuid":"10104d5b-8342-476d-a50f-e84ec4c04676","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","issue":"163","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e70943c878c28a0473b88d8"]},"journal":{"objectId":"5e714da546e0fb0001c8ee21","title":"Biuletyn Komunikacji Miejskiej","issn":"1234-9399","documentHash":"68604623-58ac-4039-8218-0924591261ae"},"_version":4,"journalIssue":{"objectId":"63d7aff04097074c742a3fe7","year":"2022","number":"163","documentHash":"70baf9b1-3580-4142-a52c-e841c4d30ae1"},"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761904375904"},{"authors":[{"objectId":"5e70943c878c28a0473b88d8","name":"Józef","lastName":"Dąbrowski","uuid":"C179DFD104F292BB3A92D1CF7FC2E4D9897B709219484D43F866FD67063B4740FEBEA913B1200F2CB6D35CA276BA482250804C84420E87F75596DFE86F4A3C3C","documentHash":"4b370d07-48e3-4a0e-8d01-8978d85b488a"}],"objectId":"63d7a9344097074c74293aeb","publicUri":"https://igkm.pl/biuletyn-komunikacji-miejskiej-nr-164-maj-2022/","type":"ARTICLE","typeName":"Artykuł","year":2022,"title":"Uwagi do propozycji zmian w rozporządzeniu w sprawie warunków technicznych, jakim powinny odpowiadać obiekty budowalne metra i ich usytuowanie","otherTitles":[],"abstracts":[],"affiliations":[{"id":"5e70918b878c28a04737ded5","uid":"b1XGvJiw-TsKhXZq-S51_4g","uuid":"10104d5b-8342-476d-a50f-e84ec4c04676","name":"Sieć Badawcza Łukasiewicz - Instytut Elektrotechniki","affiliatedPersonIDs":["5e70943c878c28a0473b88d8"],"parentId":"5e70918b878c28a04737ded5","parentUuid":"10104d5b-8342-476d-a50f-e84ec4c04676","rootId":"5e70918b878c28a04737ded5","rootUuid":"10104d5b-8342-476d-a50f-e84ec4c04676","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","volume":"164","pagesFromTo":"90-96","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e70943c878c28a0473b88d8"]},"journal":{"objectId":"63d7a9344097074c74293aec","title":"Biuletyn Informacyjny - Izba Gospodarcza Komunikacji Miejskiej","issn":"1231-1626","websiteLink":"https://igkm.pl/biuletyny/","documentHash":"74741dca-16e1-4ca4-90be-98116972b023"},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":true,"translationEditors":[],"keywords":[],"lastRefresh":"1761904375935"},{"authors":[{"objectId":"5e709389878c28a0473ac371","name":"WOJCIECH","lastName":"MATELSKI","uuid":"4056229EBFE0BE1B250D7237949C944429165C624432DD8BD813AB4F27D7CAC34A39D2B60F599ED5F2C0E9AA3F3F281C290F5F4DDD5E21E6DE6BD9399556699C","orcidId":"0000-0003-1079-3289","documentHash":"2cf92777-c48a-40ef-8745-630d12ec01a7"},{"objectId":"5e7092d8878c28a04739e025","name":"Ryszard","lastName":"Strzelecki","uuid":"F3403DC352445BF5684BE5B602B6554ECE93391D6C1B554E8D30096C3F908E6E5D431D7DF56977D2BCDBF8470342EB5C53B20AE49800CD665489374DDE658BB7","orcidId":"0000-0001-9437-9450","documentHash":"1b3adc8e-3a40-413e-9420-96733fe9be1e"}],"openAccess":{"textVersion":"FINAL_AUTHOR","license":"CC_BY","releaseDate":"2023-05-07","releaseDateMode":"AT_PUBLICATION","mode":"OPEN_JOURNAL"},"objectId":"649ac506409707195f0358df","doi":"10.15199/48.2023.05.40","publicUri":"http://pe.org.pl/articles/2023/5/40.pdf","type":"ARTICLE","typeName":"Artykuł","year":2023,"title":"Badania eksperymentalne transformatora hybrydowego jako kondycjonera napięcia w sieciach typu TN","otherTitles":[{"languageCode":"eng","title":"Experimental study of hybrid transformer as a voltage conditioner in TN-type networks"}],"abstracts":[{"languageCode":"pol","content":"Artykuł dotyczy układu dystrybucyjnego transformatora hybrydowego (DTH) przeznaczonego do zastosowania w sieciach typu TN. Opisano w nim sposoby podłączenia przewodu neutralnego do układu DTH. W dalszej części artykuł zawiera opis skonstruowanego modelu laboratoryjnego o mocy 16 kVA wraz z zastosowanym algorytmem sterowania. Ponadto przedstawiono wyniki badań eksperymentalnych, ze szczególnym uwzględnieniem oceny dokładności stabilizacji napięcia obciążenia"},{"languageCode":"eng","content":"The article concerns the hybrid distribution transformer (DTH) system for use in TN-type networks. It describes how to connect the neutral wire to the DTH system. The article next describes the constructed 16 kVA laboratory model together with the control algorithm used. Furthermore, results of experimental tests are presented, with particular emphasis on the evaluation of the accuracy of the load voltage stabilization."}],"affiliations":[{"id":"5e70918c878c28a04737e010","uid":"bSCdi0qvAL6vz0ItIVMk62g","uuid":"7f9620d4-9201-44d1-bea8-35f65adf06bd","name":"Wydział Elektrotechniki i Automatyki","affiliatedPersonIDs":["5e7092d8878c28a04739e025"],"parentId":"5e70918a878c28a04737de28","parentUuid":"76e7e103-e39c-48d6-8aa2-8fde70c50563","rootId":"5e70918a878c28a04737de28","rootUuid":"76e7e103-e39c-48d6-8a