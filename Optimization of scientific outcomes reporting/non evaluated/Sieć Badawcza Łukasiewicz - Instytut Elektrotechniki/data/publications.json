},{"objectId":"5e7094f1878c28a0473c7786","name":"Dariusz","lastName":"Świerczyński","uuid":"BBDECD98DAD9B9FE7E5ED2EA446A6A6AB084AC4DF4E8A3128A7DD60809FD27B74421B477F86C8A252D19D730DFBEBA0374EEA50CBD1D25FDB4FBC69B914BD1D7","documentHash":"07be3157-32eb-4fae-84cb-c2f0560fae0f"},{"objectId":"5e709481878c28a0473beaf3","name":"Przemysław","lastName":"Szostak","uuid":"7A7614FF5E05B72DDA644795743190035781F877C8CD52E13BF588437A9E6FED19C9C4D2D50AD20AA39911346C9F26211AB7C1AFE1F2040EC8E5661608F68B2C","documentHash":"2c6c9d55-ff45-4868-8342-0ba130df24a4"},{"objectId":"5e70943b878c28a0473b88b2","name":"Renata","lastName":"Sulima","uuid":"8EE2E11CAD13DEAF4675A75C7928D79E37C67FACAC81EAAA2EC79080FCECF6C60F962035F1617EB108A18A5ACD9CEE2DD36EFBDAF4E9F07368DC95BDE13FA6D1","documentHash":"77d7bcd3-ab5e-4d9d-a658-6db1e5d7d786"},{"objectId":"5e709411878c28a0473b5b3a","name":"Artur","lastName":"Moradewicz","uuid":"902C376D9768D9F22878A484D40C5242E1864728C14B8BBADF6CB072706516E36515EE012D8BA4E4B1F1574C806E935E6CBCC6725D856A6E783801F43896E91D","documentHash":"1e22d62f-5708-42c3-9eb1-c0310ee88a85"}],"objectId":"691d9e65fdbe834df2d75b6d","doi":"10.1109/paee68231.2025.11156089","publicUri":"https://ieeexplore.ieee.org/document/11156089","type":"CHAPTER","typeName":"Rozdział","year":2025,"title":"Integrated Drive System Cooperating with an Inductive Power Supply","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"This article presents a modern drive system for electric vehicles that combines traditional wired charging from the power grid with advanced inductive charging. The power circuit of the charger utilizes a PMSM motor structure connected with drive inverter, ensuring efficient operation and wireless vehicle charging. Thanks to its integrated design and the use of an advanced energy flow control system, the developed system ensures reliability and lower material costs."}],"affiliations":[{"id":"5e70918b878c28a04737ded5","uid":"b1XGvJiw-TsKhXZq-S51_4g","uuid":"10104d5b-8342-476d