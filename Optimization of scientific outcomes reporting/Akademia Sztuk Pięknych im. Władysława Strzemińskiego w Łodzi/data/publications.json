nukat","type":"CHAPTER","typeName":"Rozdział","year":2023,"title":"W senatorskich progach: Walewice i Mała Wieś. Prywatne wnętrza pałacowe o charakterze muzealnym.","otherTitles":[],"abstracts":[],"affiliations":[{"id":"5e70918b878c28a04737de60","uid":"b0b4YmW3kBXlJGHLoU7pKHw","uuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","name":"Akademia Sztuk Pięknych im. Władysława Strzemińskiego w Łodzi","affiliatedPersonIDs":["5e7092ec878c28a04739f41c"],"parentId":"5e70918b878c28a04737de60","parentUuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","rootId":"5e70918b878c28a04737de60","rootUuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","type":"AUTHOR"}],"mainLanguage":"pol","mainLanguageName":"polski","pagesFromTo":"[86-93]","contributionOrder":{"AUTHOR":["5e7092ec878c28a04739f41c"]},"_version":4,"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"book":{"objectId":"65f98ca44097073cad9529d2","title":"Skarbce, kolekcje i muzea Mazowsza","year":2023,"isbn":"978-83-66546-89-9","url":"https://katalogi.bn.org.pl/permalink/48OMNIS_NLOP/1aot9i7/alma991053096980405066","translation":false,"documentHash":"83ee6df1-b86f-409f-8d33-41da72c348c5","publisher":{"objectId":"5d35987c878c28139f4eb945","mniswId":"72500","name":"Wydawnictwo Naukowe Sub Lupa","documentHash":"7a75ed26-fbe4-4b8e-851a-aebc7013612c"},"bookEvaluation":{"scientificEdition":false,"translationToPolish":false,"translationFromPolish":false,"bookProjectNCN":false,"bookProjectFNP":false,"bookProjectNPHR":false,"bookProjectUE":false}},"keywords":[],"lastRefresh":"1764114222626"},{"authors":[{"objectId":"5e7092b9878c28a04739b72b","name":"Łukasz","lastName":"Sadowski","uuid":"54095E3A028E6E02837B0F4D4B49CB25576F658511F5ADF2AE7ED0F60F7E81F5138AFFF0DB20F4B23799D7D764EDA056A2A78B7AFEA630F1D19FD61D70B0033C","documentHash":"4931d038-0d73-4290-954d-e91a49be47a1"}],"objectId":"6932b8fffdbe837a1cf2c763","doi":"10.35784/odk.7289","publicUri":"https://ph.pollub.pl/index.php/odk/article/view/7289","type":"ARTICLE","typeName":"Artykuł","year":2025,"title":"Authentic or not? Art historian's reflections on castle reconstructions in contemporary Poland","otherTitles":[],"abstracts":[{"languageCode":"eng","content":"In Poland, most castles were destroyed as early as the 17th and 18th centuries as a result of numerous wars. In the following centuries, an unfavourable political situation or just economic considerations caused numerous demolitions. A significant number of castles disappeared, or functioned as ‘romantic ruins’. A few important castles were rebuilt in the 19th century, in the spirit of ‘historical revival’. In the 20th century, many of the most important buildings  were rebuilt or even reconstructed from scratch. In most cases, the sites were rebuilt immediately after the end of the war, by people who knew the buildings from autopsy, before demolishion.\n\n\nFor many years, castle ruins functioned in the Polish landscape as ‘permanent ruins’. After the fall of communism, reconstruction of some castles began at the beginning of the 21st century. The most spectacular example may be the ‘reconstruction’ of the castle in Poznan – one of the most important cities in Poland. It was rebuilt on the basis of poor iconographic material – no older than from the 18th century. However, a large part of city dwellers suport the fact that the former capital of Greater Poland had ‘reclaimed’ its castle. Another ‘reconstruction’ of recent years is the Bobolice Castle, praised by numerous tourists and heavily criticised by art historians and conservators. Contemporary castle reconstructions are becoming a worrying trend. It may, in future pose a serious threat to the authentic, substance of historical castle buildings."}],"affiliations":[{"id":"5e70918b878c28a04737de60","uid":"b0b4YmW3kBXlJGHLoU7pKHw","uuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","name":"Akademia Sztuk Pięknych im. Władysława Strzemińskiego w Łodzi","affiliatedPersonIDs":["5e7092b9878c28a04739b72b"],"parentId":"5e70918b878c28a04737de60","parentUuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","rootId":"5e70918b878c28a04737de60","rootUuid":"c50bd2eb-f024-47a4-abb2-5f5ba6de7627","type":"AUTHOR"}],"mainLanguage":"eng","mainLanguageName":"angielski","issue":"23","pagesFromTo":"121-130","articleEvaluation":{"indexedJournal":false,"isReview":true,"wosConference":false},"contributionOrder":{"AUTHOR":["5e7092b9878c28a04739b72b"]},"journal":{"objectId":"5e6f7d60878c28514547ee91","mniswId":"200177","title":"Ochrona Dziedzictwa Kulturowego","issn":"2543-6422","eissn":"2543-6422","metadataSource":"ERIH","documentHash":"563b9bdd-727c-4ac8-bfc4-ec50e7ce7471"},"_version":4,"journalIssue":{"objectId":"6932b8fffdbe837a1cf2c764","year":"2025","number":"23","documentHash":"8b67eb03-b9b8-458e-adeb-2e1060fe5aa9"},"translation":false,"editors":[],"translators":[],"institutionProfile":false,"translationEditors":[],"keywords":[{"languageCode":"eng","keywords":["Reconstructions","Castles","Authenticity"]}],"lastRefresh":"1764978753566"}]